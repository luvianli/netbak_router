#=================================================================
# huayi_platform.mk:
# - included by package.mk / kernel-defaults.mk
#
# 1. This file defines huayi specific C compile flags based on 
# product selection specified in <PRODUCT>.conf (CONFIG_HUAYI_PLATFORM_SUPPORT). 
# 
# 2. The added compile flags are visible to kernel/kernel modules/user programs
# compilation. 
# - For kernel: passed as CFLAGS_KERNEL (kernel-defaults.mk)
# - For kernel modules / user program: passed as EXTRA_FLAGS 
# 
#=================================================================

ifeq ($(CONFIG_HUAYI_PLATFORM_SUPPORT),y)
	EXTRA_CFLAGS += -DCONFIG_HUAYI_PLATFORM_SUPPORT
	EXTRA_CFLAGS += -DCONFIG_HUAYI_ETH_PORT_NUM=${CONFIG_HUAYI_ETH_PORT_NUM}
	EXTRA_CFLAGS += -DCONFIG_HUAYI_LAN1_PORT_NUM_OFFSET=${CONFIG_HUAYI_LAN1_PORT_NUM_OFFSET}
	EXTRA_CFLAGS += -DCONFIG_HUAYI_FACTORY_MTD_NUM=${CONFIG_HUAYI_FACTORY_MTD_NUM}
