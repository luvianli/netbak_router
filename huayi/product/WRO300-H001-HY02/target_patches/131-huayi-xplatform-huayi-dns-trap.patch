diff -uNr a/net/bridge/br_huayi_dns_trap.c b/net/bridge/br_huayi_dns_trap.c
--- a/net/bridge/br_huayi_dns_trap.c	1970-01-01 08:00:00.000000000 +0800
+++ b/net/bridge/br_huayi_dns_trap.c	2020-04-22 16:04:44.434143662 +0800
@@ -0,0 +1,293 @@
+#if defined(CONFIG_HUAYI_SUPPORT_DNS_TRAP)
+#include <linux/version.h>
+#include <linux/ip.h>
+#include <linux/in.h>
+#include <linux/inetdevice.h>
+#include <net/checksum.h>
+#include <net/udp.h>
+#include <linux/ctype.h>
+#include <linux/kernel.h>
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+
+#include "br_private.h"
+
+#include "br_huayi_dns_trap.h"
+
+unsigned char domain_name[80];
+//unsigned char dns_answer[] = { 0xC0, 0x0C, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x03, 0x84, 0x00, 0x04 };
+
+unsigned char dns_answer[] = { 0xC0, 0x0C, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x04 };
+
+int dns_filter_enable = 1;
+
+#define DEFAULT_HOSTNAME "setup.wifi.net"
+
+void str_to_lower(char *s)
+{
+	if(s!=NULL)
+	{
+    	while (*s != '\0') 
+		{
+        	*s = __tolower(*s);
+        	++s;
+    	}
+	}
+}
+
+int __init br_dns_filter_init(void)
+{
+	memset(domain_name,0,sizeof(domain_name));
+	strcpy(domain_name,DEFAULT_HOSTNAME);
+	str_to_lower(domain_name);
+	return 0;
+}
+
+int is_dns_packet(struct sk_buff *skb)
+{
+	struct iphdr *iph;
+	struct udphdr *udph;
+	iph = (void *)skb->data;
+	if (iph) {
+		udph = (void *)iph + iph->ihl*4;
+		if (iph->protocol==IPPROTO_UDP && (udph->dest == htons(53) || udph->source == htons(53))) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static int is_valid_dns_query_header(dnsheader_t *dns_header)
+{
+	if(dns_header == NULL)
+	{
+		return 0;
+	}
+	DNS_TRAP_DEBUG("[%s]qdcount:%d\n",__FUNCTION__,dns_header->qdcount);
+	if(dns_header->qdcount < 1)
+	{
+		return 0;
+	}
+	if(((dns_header->u & 0x8000)>>15)!= 0)/*QR: query should be 0,answer be 1*/
+	{
+		DNS_TRAP_DEBUG("[%s]QR!=0!\n",__FUNCTION__);
+		return 0;
+	}
+	if(((dns_header->u & 0x7100)>>11) != 0)/*opcode: 0:standard,1:reverse,2:server status*/
+	{
+		DNS_TRAP_DEBUG("[%s]opcode!=0!\n",__FUNCTION__);
+		return 0;
+	}
+	if(((dns_header->u & 0x70)>>4) != 0)/*Z: reserved, should be 0*/
+	{
+		DNS_TRAP_DEBUG("[%s]Z!=0!\n",__FUNCTION__);
+		return 0;
+	}
+	return 1;
+}
+
+static int get_domain_name(unsigned char* dns_body,char* domain_name,int body_len)
+{
+	int offset = 0,token_len = 0;
+	char token[64] = {0};
+	char domain[128] = {0};
+	if(!dns_body || !domain_name || body_len <= 0){
+		return -1;
+	}
+	while(body_len > 0){
+		memset(token,0,sizeof(token));
+		token_len = dns_body[offset];
+		if(token_len > 0){
+			strncpy(token,dns_body+offset+1,token_len);
+			if(!domain[0]){
+				strcpy(domain,token);
+			}
+			else{
+				strcat(domain,".");
+				strcat(domain,token);
+			}
+		}
+		else 
+		{
+			break;
+		}
+		token_len +=1;
+		body_len -= token_len;
+		offset += token_len;
+	}
+	strcpy(domain_name,domain);
+	return 0;
+}
+
+static int is_domain_name_equal(char *domain_name1, char * domain_name2)
+{
+	char temp1[128];
+	char temp2[128];
+	if(!domain_name1 || !domain_name2)
+	{
+		return 0;
+	}
+	str_to_lower(domain_name1);
+	str_to_lower(domain_name2);
+	if(!strncmp(domain_name1,"www.",4)){
+		strcpy(temp1,domain_name1+4);
+	}
+	else{
+		strcpy(temp1,domain_name1);
+	}
+	if(!strncmp(domain_name2,"www.",4)){
+		strcpy(temp2,domain_name2+4);
+	}
+	else{
+		strcpy(temp2,domain_name2);
+	}
+	if(strcmp(temp1,temp2))
+		return 0;
+	else
+		return 1;
+}
+
+int br_dns_packet_recap(struct sk_buff *skb)
+{
+	struct iphdr *iph;
+	struct udphdr *udph;
+	struct net_device *brlan_dev; 
+	struct in_device *brlan_in_dev;
+	struct in_ifaddr *ifa_next = NULL;
+	dnsheader_t *dns_pkt;
+	unsigned char mac[ETH_ALEN];
+	unsigned int ip;
+	unsigned short port;
+	unsigned char *ptr = NULL;
+
+	brlan_dev = dev_get_by_name(&init_net,"br-lan");
+
+	if(!brlan_dev)	
+	{
+		return -1;
+	}
+	
+	brlan_in_dev = in_dev_get(brlan_dev);
+
+	if(!brlan_in_dev)	
+	{
+		if(brlan_dev)
+			dev_put(brlan_dev);
+		return -1;
+	}
+
+	iph = ip_hdr(skb);
+	udph = (void *)iph + iph->ihl*4;
+	dns_pkt = (void *)udph + sizeof(struct udphdr);
+	ptr = (void *)udph + ntohs(udph->len);
+
+	skb_put(skb, 16);
+
+	/* swap mac address */
+	memcpy(mac, eth_hdr(skb)->h_dest, ETH_ALEN);
+	memcpy(eth_hdr(skb)->h_dest, eth_hdr(skb)->h_source, ETH_ALEN);
+	memcpy(eth_hdr(skb)->h_source, mac, ETH_ALEN);
+
+	/*swap ip address */
+	ip = iph->saddr;
+	iph->saddr = iph->daddr;
+	iph->daddr = ip;
+	iph->tot_len = iph->tot_len+htons(16);
+	DNS_TRAP_DEBUG("[%s]iph->tot_len:%d\n",__FUNCTION__,iph->tot_len);
+
+	/* swap udp port */
+	port = udph->source;
+	udph->source = udph->dest;
+	udph->dest = port;
+	udph->len = udph->len+htons(16);
+	dns_pkt->u = htons(0x8180);
+	dns_pkt->qdcount = htons(1);
+	dns_pkt->ancount = htons(1);
+	dns_pkt->nscount = htons(0);
+	dns_pkt->arcount = htons(0);
+	DNS_TRAP_DEBUG("[%s]udph->len:%d\n",__FUNCTION__,ntohs(udph->len));
+	DNS_TRAP_DEBUG("[%s]dns_pkt->u:%x\n",__FUNCTION__,ntohs(dns_pkt->u));
+	DNS_TRAP_DEBUG("[%s]dns_pkt->qdcount:%x\n",__FUNCTION__,ntohs(dns_pkt->qdcount));
+	DNS_TRAP_DEBUG("[%s]dns_pkt->ancount:%x\n",__FUNCTION__,ntohs(dns_pkt->ancount));
+	DNS_TRAP_DEBUG("[%s]dns_pkt->nscount:%x\n",__FUNCTION__,ntohs(dns_pkt->nscount));
+	DNS_TRAP_DEBUG("[%s]dns_pkt->arcount:%x\n",__FUNCTION__,ntohs(dns_pkt->arcount));
+	/* pad Answers */
+	memcpy(ptr, dns_answer, 12);
+	
+	memcpy(ptr+12, (unsigned char *)&brlan_in_dev->ifa_list->ifa_address, 4);
+
+	ifa_next=brlan_in_dev->ifa_list->ifa_next;
+	if (ifa_next != NULL)
+	{
+		memcpy(ptr+12, (unsigned char *)&ifa_next->ifa_address, 4);
+	}
+	
+	/* ip checksum */
+	skb->ip_summed = CHECKSUM_NONE;
+	iph->check = 0;
+	iph->check = ip_fast_csum((unsigned char *)iph, iph->ihl);
+
+	/* udp checksum */
+	udph->check = 0;
+	udph->check = csum_tcpudp_magic(iph->saddr, iph->daddr,
+					ntohs(udph->len), IPPROTO_UDP,
+					csum_partial((char *)udph,
+					             ntohs(udph->len), 0));
+    if(brlan_in_dev)
+        in_dev_put(brlan_in_dev);
+    if(brlan_dev)
+        dev_put(brlan_dev);
+
+	return 1;
+}
+
+int br_dns_filter_enter(struct sk_buff *skb)
+{
+	struct iphdr *iph;
+	struct udphdr *udph;
+	unsigned char *body = NULL;
+	dnsheader_t *dns_hdr = NULL;
+	int len = 0;
+	char domain[512] = {0};
+
+	if(eth_hdr(skb)->h_proto != htons(ETH_P_IP))
+	{
+		return 0;
+	}
+		
+	iph = (struct iphdr *)skb_network_header(skb);
+	if(NULL == iph)
+	{
+		return 0;
+	}
+	
+	udph = (void *)iph + iph->ihl*4;
+	if (iph->protocol==IPPROTO_UDP && ntohs(udph->dest) == 53&& ((iph->frag_off & htons(0x3FFF))==0)&&(ntohs(iph->tot_len-udph->len)>=20)) {
+		DNS_TRAP_DEBUG("[%s:%d]DNS packet\n",__FUNCTION__,__LINE__);
+		len = ntohs(udph->len) - sizeof(struct udphdr) - sizeof(dnsheader_t) - 4;
+		if(len <=1 || len > 63)
+		{
+			return 1;
+		}
+
+		dns_hdr = (dnsheader_t*)((void*)udph + sizeof(struct udphdr));
+		if(!is_valid_dns_query_header(dns_hdr))
+		{
+			return 1;
+		}
+		body = (void *)udph + sizeof(struct udphdr) + sizeof(dnsheader_t);
+		//DNS_TRAP_DEBUG("[%s:%d]DNS packet urlis[%s]\n",__FUNCTION__,__LINE__,body);
+		get_domain_name(body,domain,len);
+		DNS_TRAP_DEBUG("[%s:%d]domain_name is %s\n",__FUNCTION__,__LINE__,domain);
+		if(is_domain_name_equal(domain,domain_name)){
+			DNS_TRAP_DEBUG("[%s:%d]%s matched!!!\n",__FUNCTION__,__LINE__,domain);
+			br_dns_packet_recap(skb);
+		}
+		return 1;
+	}
+
+	return 0;
+}
+
+#endif
+
