+{
+	u8 code = OPCODE_RD_UID;
+	int retval = 0;
+	u8  rxbuf[32] = {0};
+	
+#ifdef MORE_BUF_MODE
+	retval = huayi_bbu_spic_trans(code, 0, rxbuf, 1, 24);
+	
+	if ((rxbuf[16] == 0xc8) && (rxbuf[17] == 0x01) &&
+		(rxbuf[18] == 0x35) && (rxbuf[19] == 0xb5))
+	{
+			printk("flash is true,the customer id=0x%x,0x%x,0x%x,0x%x\n", rxbuf[16],
+        	rxbuf[17], rxbuf[18], rxbuf[19]);
+	}
+	else
+	{
+		while(1)
+		{
+			msleep(3000);
+			printk("flash is error,the customer id not find\n");
+		}
+	}
+#endif
+	
+	return retval;
+}
+#endif
