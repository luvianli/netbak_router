+#if defined (CONFIG_HUAYI_SUPPORT_GPIO_EVENT)
+static struct sock *gpio_netlinkfd = NULL;
+
+struct netlink_kernel_cfg netlink_cfg;
+
+int huayi_gpio_event_send_msg(int8_t *pbuf, uint16_t len)
+{
+    struct sk_buff *nl_skb;
+    struct nlmsghdr *nlh;
+    int ret;
+
+    nl_skb = nlmsg_new(len, GFP_ATOMIC);
+
+	if(!nl_skb)
+    {
+        printk("netlink_alloc_skb error\n");
+		
+        return -1;
+    }
+
+    nlh = nlmsg_put(nl_skb, 0, 0, 28, len, 0);
+
+	if(nlh == NULL)
+    {
+        printk("nlmsg_put() error\n");
+
+		nlmsg_free(nl_skb);
+
+		return -1;
+    }
+	
+    memcpy(nlmsg_data(nlh), pbuf, len);
+
+    ret = netlink_unicast(gpio_netlinkfd, nl_skb, HUAYI_GPIO_NETLINK_PORT_ID, MSG_DONTWAIT);
+
+    return ret;
+}
+
+
+int huayi_gpio_event_send(struct huayi_gpio_event* e)
+{
+	return	huayi_gpio_event_send_msg((char*)e,sizeof(struct huayi_gpio_event));
+}
+
+static void huayi_gpio_notification(int gpio_no,int status)
+{
+	struct huayi_gpio_event e;
+
+	memset(&e,0,sizeof(struct huayi_gpio_event));
+	
+	e.gpio_id = gpio_no;	
+
+	e.status = status;	
+
+	huayi_gpio_event_send(&e);
+	
+	return;
+}
+
+static void huayi_netlink_recv_gpio(struct sk_buff *skb)
+{
+    struct nlmsghdr *nlh = NULL;
+
+	struct huayi_notification *e;
+	
+    if(skb->len >= nlmsg_total_size(0))
+    {
+        nlh = nlmsg_hdr(skb);
+
+		e = NLMSG_DATA(nlh);
+    }
+} 
+
+static void netlink_cfg_init(struct netlink_kernel_cfg *cfg)
+{
+	memset(cfg,0,sizeof(cfg));
+
+	cfg->groups = 0;   /*unicast*/
+
+	cfg->input = huayi_netlink_recv_gpio;
+
+	return;
+}
+
+static int __init huayi_gpio_event_init(void)
+{
+	netlink_cfg_init(&netlink_cfg);
+	
+    gpio_netlinkfd = netlink_kernel_create(&init_net, HUAYI_GPIO_NETLINK_MSG_TYPE, &netlink_cfg);
+
+	if(!gpio_netlinkfd)
+    {
+        printk("can not create a netlink socket!\n");
+
+		return -1;
+    }
+
+	//printk("huayi_gpio_event_init!\n");
+
+	return 0;
+}
+
+static void __exit huayi_gpio_event_exit(void)
+{
+	sock_release(gpio_netlinkfd->sk_socket);
+
+	//printk("huayi_gpio_event exit\n!");
+
+	return;
+}
