diff -uNr a/drivers/net/raeth/raether.c b/drivers/net/raeth/raether.c
--- a/drivers/net/raeth/raether.c	2020-07-17 10:49:31.964215616 +0800
+++ b/drivers/net/raeth/raether.c	2020-07-16 20:09:36.975688109 +0800
@@ -2329,6 +2329,24 @@
 		printk("RT305x_ESW: Link Status Changed \n");
 
 		stat_curr = *((volatile u32 *)(RALINK_ETH_SW_BASE+0x80));
+		
+#if defined(CONFIG_HUAYI_PORT_EVENT)  && defined (CONFIG_RALINK_MT7628)/*add by huayi for port event 20190906*/	
+		for (port_no = 0; port_no < 5; port_no++)
+		{
+			if (((stat & (1<<(port_no+25))) && !(stat_curr & (1<<(port_no+25)))))
+			{
+				link  = 0;
+				raeth_port_notification(port_no,link);
+			}
+			else if ((!(stat & (1<<(port_no+25))) && (stat_curr & (1<<(port_no+25)))))
+			{
+				link  = 1;
+				raeth_port_notification(port_no,link);
+			}
+		}
+		port_no = 255;
+		stat = stat_curr;
+#else
 
 #ifdef CONFIG_WAN_AT_P0
 		//link down --> link up : send signal to user application
@@ -2356,6 +2374,7 @@
 		schedule_work(&ei_local->kill_sig_wq);
 out:
 		stat = stat_curr;
+#endif
 	}
 
 #endif // defined(CONFIG_RALINK_RT6855) || defined(CONFIG_RALINK_RT6855A)//