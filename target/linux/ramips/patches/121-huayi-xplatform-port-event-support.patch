--- a/drivers/net/raeth/huayi_port_event.c	2019-09-06 14:51:57.136017502 +0800
+++ b/drivers/net/raeth/huayi_port_event.c	2019-09-06 14:53:30.210341892 +0800
@@ -0,0 +1,141 @@
+/*******************************************************************************************
+ * Project:  huayi_port_event                                                                    *
+ *                                                                                         *
+ * Author :  huayi								                                      	   *  
+ *  																					   * 
+ * Changelist: 																		       *
+ * 20190906 add by huayi  Version 0.0 													   *
+ ******************************************************************************************/
+
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/sched.h>
+#include <net/sock.h>
+#include <linux/netlink.h>
+#include "huayi_port_event.h"
+
+
+
+static struct sock *netlinkfd = NULL;
+
+struct netlink_kernel_cfg cfg;
+
+
+void print_mem (unsigned char *p, int k)
+{
+	int i;
+	printk("\n");
+
+	for (i = 0; i < k; i++)
+	{
+		printk("%02x ", *p++);
+
+		if ((i + 1) % 16 == 0) printk("\n");
+	}
+
+	printk("\n");
+}
+
+
+
+int huayi_port_event_send_msg(int8_t *pbuf, uint16_t len)
+{
+    struct sk_buff *nl_skb;
+    struct nlmsghdr *nlh;
+    int ret;
+
+    nl_skb = nlmsg_new(len, GFP_ATOMIC);
+
+	if(!nl_skb)
+    {
+        printk("netlink_alloc_skb error\n");
+		
+        return -1;
+    }
+
+    nlh = nlmsg_put(nl_skb, 0, 0, 28, len, 0);
+
+	if(nlh == NULL)
+    {
+        printk("nlmsg_put() error\n");
+
+		nlmsg_free(nl_skb);
+
+		return -1;
+    }
+	
+    memcpy(nlmsg_data(nlh), pbuf, len);
+
+    ret = netlink_unicast(netlinkfd, nl_skb, HUAYI_PORT_NETLINK_PORT_ID, MSG_DONTWAIT);
+
+    return ret;
+}
+
+
+int huayi_port_event_send(struct huayi_port_event* e)
+{	
+	return	huayi_port_event_send_msg((char*)e,sizeof(struct huayi_port_event));
+}
+EXPORT_SYMBOL(huayi_port_event_send);
+
+
+static void huayi_netlink_recv_cb(struct sk_buff *skb)
+{
+    struct nlmsghdr *nlh = NULL;
+	struct huayi_notification *e;
+	
+    if(skb->len >= nlmsg_total_size(0))
+    {
+        nlh = nlmsg_hdr(skb);
+
+		e = NLMSG_DATA(nlh);
+    }
+} 
+
+
+static void netlink_cfg_init(struct netlink_kernel_cfg *cfg)
+{
+	memset(cfg,0,sizeof(cfg));
+
+	cfg->groups = 0;   /*unicast*/
+
+	cfg->input = huayi_netlink_recv_cb;
+
+	return;
+}
+
+static int __init huayi_port_event_init(void)
+{
+	netlink_cfg_init(&cfg);
+	
+    netlinkfd = netlink_kernel_create(&init_net, HUAYI_PORT_NETLINK_MSG_TYPE, &cfg);
+
+	if(!netlinkfd)
+    {
+        printk("can not create a netlink socket!\n");
+
+		return -1;
+    }
+
+	//printk("huayi_port_event_init!\n");
+
+	return 0;
+}
+
+static void __exit huayi_port_event_exit(void)
+{
+	sock_release(netlinkfd->sk_socket);
+
+	//printk("huayi_port_event exit\n!");
+
+	return;
+}
+
+module_init(huayi_port_event_init);
+module_exit(huayi_port_event_exit);
+MODULE_LICENSE("GPL");  
+MODULE_AUTHOR("huayi.luo@fixdlink.com");  
+MODULE_DESCRIPTION("huayi port event");
