@@ -61,8 +61,7 @@
 {
 	if (dev->udev->descriptor.idVendor != cpu_to_le16(0x2C7C)) 
 		return skb;
-	if (dev->udev->descriptor.idVendor != cpu_to_le16(0x05C6)) 
-		return skb;
+	
 	// Skip Ethernet header from message	
 	if (skb_pull(skb, ETH_HLEN)) {		
 		return skb;	
@@ -101,6 +100,9 @@
 {
 	__be16 proto;
 
+	if (dev->udev->descriptor.idVendor !=cpu_to_le16(0x2C7C))
+		return 1;
+	
 	/* This check is no longer done by usbnet */
 	if (skb->len < dev->net->hard_header_len)
 		return 0;
@@ -355,10 +357,9 @@
 	dev->net->netdev_ops = &qmi_wwan_netdev_ops;
 #if 1 
 	//Added by Quectel
-	if (dev->udev->descriptor.idVendor == cpu_to_le16(0x2C7C) || 
-		dev->udev->descriptor.idVendor == cpu_to_le16(0x05C6)) 
+	if (dev->udev->descriptor.idVendor == cpu_to_le16(0x2C7C)) 
 	{
-		dev_info(&intf->dev, "Quectel EC25&EC21&EG91&EG95&EG06&EP06&EM06&BG96&AG35 work on RawIP mode\n");
+		dev_info(&intf->dev, "Quectel EC25&EC20 R2.0 work on RawIP mode\n");
 		dev->net->flags |= IFF_NOARP;
 		usb_control_msg(
 			interface_to_usbdev(intf),
@@ -555,6 +556,7 @@
 	},
 
 	/* 3. Combined interface devices matching on interface number */
+	{QMI_FIXED_INTF(0x2C7C, 0x0125, 4) }, /* Quectel EC25 EC20 R2.0*/
 	{QMI_FIXED_INTF(0x0408, 0xea42, 4)},	/* Yota / Megafon M100-1 */
 	{QMI_FIXED_INTF(0x05c6, 0x7000, 0)},
 	{QMI_FIXED_INTF(0x05c6, 0x7001, 1)},
@@ -853,9 +855,6 @@
 	{QMI_GOBI_DEVICE(0x1199, 0x901b)},	/* Sierra Wireless MC7770 */
 	{QMI_GOBI_DEVICE(0x12d1, 0x14f1)},	/* Sony Gobi 3000 Composite */
 	{QMI_GOBI_DEVICE(0x1410, 0xa021)},	/* Foxconn Gobi 3000 Modem device (Novatel E396) */
-	
-	{QMI_FIXED_INTF(0x2C7C, 0x0125, 4) }, /* Quectel EC25 */
-	
 	{ }					/* END */
 };
 MODULE_DEVICE_TABLE(usb, products);
