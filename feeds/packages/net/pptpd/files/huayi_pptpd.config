config service 'pptpd'
       option 'enable' 0
       option 'server_ip' '192.168.7.1'
       option 'startip' '172.1.1.10'
       option 'endip'   '172.1.1.20'
       option 'mtu' 1482
       option 'mru' 1482
       option 'lcp_echo_failure' 3
       option 'lcp_echo_interval' 60
       option 'mppe' 0
       option 'dns_enable' 0
       option 'primary_dns' ''
       option 'secondary_dns' ''
