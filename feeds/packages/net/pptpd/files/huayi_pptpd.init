#!/bin/sh /etc/rc.common
# Copyright (C) 2015 OpenWrt.org

START=60
USE_PROCD=1

BIN=/usr/sbin/pptpd
CONFIG=/var/etc/pptpd.conf
OPTION_CONFIG=/var/etc/options.pptpd

validate_pptpd_section() {
	uci_validate_section "${1}" service  pptpd\
		'enable:uinteger' \
		'server_ip:string' \
		'startip:string' \
		'endip:string' \
		'mtu:uinteger' \
		'mru:uinteger' \
		'lcp_echo_failure:uinteger' \
		'lcp_echo_interval:uinteger' \
		'mppe:uinteger' \
		'dns_enable:uinteger' \
		'primary_dns:string' \
		'secondary_dns:string' 
}

setup_config() {
	local remoteip
	validate_pptpd_section "${1}" || {
		echo "validation failed"
		return 1
	}
	
	[ "$enable" -eq 0 ] && return 1
	
	mkdir -p /var/etc
	cp /etc/ppp/options.pptpd $OPTION_CONFIG
	
	[ -n "$mtu" ] && echo "mtu $mtu" >> $OPTION_CONFIG
	
	[ -n "$mru" ] && echo "mru $mru" >> $OPTION_CONFIG
	
	[ -n "$lcp_echo_failure" ] && echo "lcp-echo-failure $lcp_echo_failure" >> $OPTION_CONFIG
	
	[ -n "$lcp_echo_interval" ] && echo "lcp-echo-interval $lcp_echo_interval" >> $OPTION_CONFIG

	[ "$mppe" -eq 0 ] && echo "mppe required,no40,no56,stateless" >> $OPTION_CONFIG
	[ "$mppe" -eq 1 ] && echo "mppe stateless" >> $OPTION_CONFIG
	[ "$mppe" -eq 2 ] && echo "nomppe" >> $OPTION_CONFIG

	[ "$dns_enable" -eq 1 ] && echo "ms-dns $primary_dns" >> $OPTION_CONFIG  
	[ "$dns_enable" -eq 1 ] && echo "ms-dns $secondary_dns" >> $OPTION_CONFIG
	
	mkdir -p /var/etc
	cp /etc/pptpd.conf $CONFIG

	[ -n "$server_ip" ] && echo "localip  $server_ip" >> $CONFIG
	
	[ -n "$startip" ] && [ -n "$endip" ] &&{
		remoteip=$startip-${endip##*.}
	}
	
	[ -n "$remoteip" ] && echo "remoteip  $remoteip" >> $CONFIG

	return 0
}

start_service() {
	config_load pptpd
	setup_config pptpd || return
	procd_open_instance
	procd_set_param command $BIN -c $CONFIG
	procd_close_instance
}

stop_service() {
	service_stop $BIN
	rm -rf $OPTION_CONFIG
	rm -rf $CONFIG
}
