#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2011 OpenWrt.org

START=99

USE_PROCD=1
PROG=/usr/sbin/hy_internet_strategy


start_service() {
	huayi_cmd set blend cpe_link 1
	huayi_cmd set network wan_link 1
    procd_open_instance
	procd_set_param command "$PROG" 
	procd_set_param respawn 0
	procd_close_instance
}

stop_service(){
	service_stop "$PROG"
}
