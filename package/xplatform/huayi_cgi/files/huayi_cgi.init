#!/bin/sh /etc/rc.common

START=97

USE_PROCD=1

start_service() {
	spawn-fcgi -f /etc/nginx/cgi-bin/cgi_huayi.cgi -s /var/run/cgi_huayi.sock 2>/dev/null
	spawn-fcgi -f /etc/nginx/cgi-bin/cgi_stream.cgi -s /var/run/cgi_stream.sock 2>/dev/null
	if [ -f "/etc/nginx/cgi-bin/cgi_modem.cgi" ];then
		spawn-fcgi -f /etc/nginx/cgi-bin/cgi_modem.cgi -s /var/run/cgi_modem.sock 2>/dev/null
	fi
}

stop_service() {
    killall spawn-fcgi
}

