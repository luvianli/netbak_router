#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2011 OpenWrt.org

START=99


openvpn_client_init(){
	server_hostname=$(uci -q get ppl2tp.openvpn.host_name)
	port=$(uci -q get ppl2tp.openvpn.port)
	username=$(uci -q get ppl2tp.openvpn.username)
	password=$(uci -q get ppl2tp.openvpn.password)
	option=$(uci -q get ppl2tp.openvpn.option)
	enable=$(uci -q get ppl2tp.openvpn.enable)

	if [ "$option" -eq "0" ]; then
		if [ "$enable" -eq "1" ]; then
			mkdir -p /path/to/
			echo "$username" > /path/to/credentials
			echo "$password" >> /path/to/credentials

			cat <<EOF > /etc/openvpn/openvpn.conf
client
dev tun
proto udp
remote $server_hostname $port
resolv-retry infinite
nobind
persist-key
persist-tun
cipher AES-256-CBC
comp-lzo
verb 3
auth-user-pass /path/to/credentials
EOF
			uci set ppl2tp.openvpn.dev=tun
			echo nameserver 8.8.8.8 > /tmp/resolv.conf.auto
			echo nameserver 8.8.4.4 >> /tmp/resolv.conf.auto
		else
			echo "OpenVPN is disabled in the configuration."
		fi
	else
		DEV=$(awk '/^dev/ {print $2}' /etc/openvpn/openVPN.ovpn)
		uci set ppl2tp.openvpn.dev=$DEV
		echo nameserver 8.8.8.8 > /tmp/resolv.conf.auto
		echo nameserver 8.8.4.4 >> /tmp/resolv.conf.auto
	fi

	chmod 600 /etc/openvpn/openVPN.ovpn
}

start() {
    echo "Starting OpenVPN service..."
	killall openvpn
	openvpn_client_init
	openvpn --config /etc/openvpn/openVPN.ovpn --daemon
}

stop(){
	echo "Stopping OpenVPN service..."
	killall openvpn
}
