#!/bin/sh /etc/rc.common

START=98
#STOP=10
#ly add
start_init() {


    server_ip=$(uci -q get ppl2tp.xl2tp.server_ip)
    route_type=$(uci -q get ppl2tp.xl2tp.route_type)
    enable_ipsec=$(uci -q get ppl2tp.xl2tp.ipsec_enable)
    ipsec_key=$(uci -q get ppl2tp.xl2tp.ipsec_key)


    if [ "$enable_ipsec" -eq 1 ]; then
		echo " " >> /etc/ipsec.conf
        echo "conn eaoinfo" >> /etc/ipsec.conf
        echo "    keyexchange=ikev1" >> /etc/ipsec.conf
        echo "    authby=secret" >> /etc/ipsec.conf
        echo "    pfs=no" >> /etc/ipsec.conf
        echo "    auto=start" >> /etc/ipsec.conf
        echo "    left=%defaultroute" >> /etc/ipsec.conf
        echo "    leftprotoport=17/1701" >> /etc/ipsec.conf
        echo "    right=${server_ip}" >> /etc/ipsec.conf
        echo "    rightprotoport=17/1701" >> /etc/ipsec.conf
        echo "    type=transport" >> /etc/ipsec.conf
        echo "    ike=aes128-sha1-modp1024" >> /etc/ipsec.conf
        echo "    phase2alg=aes128-sha1" >> /etc/ipsec.conf
        echo "%any ${server_ip} : PSK ${ipsec_key}" > /etc/ipsec.secrets
    fi


    echo "ppl2tp" > /etc/ppp/options.l2tp
    echo "require-mschap-v2" >> /etc/ppp/options.l2tp
    echo "ms-dns 8.8.8.8" >> /etc/ppp/options.l2tp
    echo "ms-dns 8.8.4.4" >> /etc/ppp/options.l2tp

    echo "lock" >> /etc/ppp/options.l2tp
    echo "noccp" >> /etc/ppp/options.l2tp
    echo "nobsdcomp" >> /etc/ppp/options.l2tp
    echo "novj" >> /etc/ppp/options.l2tp
    echo "novjccomp" >> /etc/ppp/options.l2tp
    echo "nopcomp" >> /etc/ppp/options.l2tp
    echo "noaccomp" >> /etc/ppp/options.l2tp

    echo "connect-delay 5000" >> /etc/ppp/options.l2tp
    echo "plugin pppol2tp.so" >> /etc/ppp/options.l2tp
    echo "pppol2tp 10.0.0.1:17" >> /etc/ppp/options.l2tp

    if [ "$route_type" -eq 0 ]; then
        echo "noccp" >> /etc/ppp/options.l2tp
        echo "nobsdcomp" >> /etc/ppp/options.l2tp
        echo "novj" >> /etc/ppp/options.l2tp
        echo "novjccomp" >> /etc/ppp/options.l2tp
        echo "nopcomp" >> /etc/ppp/options.l2tp
        echo "noaccomp" >> /etc/ppp/options.l2tp
    fi

    echo "plugin pppoe.so" > /etc/ppp/peers/l2tp
    echo "plugin pppox.so" >> /etc/ppp/peers/l2tp
    echo "user \"${username}\"" >> /etc/ppp/peers/l2tp
    echo "password \"${password}\"" >> /etc/ppp/peers/l2tp
    echo "noauth" >> /etc/ppp/peers/l2tp
    echo "lcp-echo-interval 15" >> /etc/ppp/peers/l2tp
    echo "lcp-echo-failure 3" >> /etc/ppp/peers/l2tp
    echo "defaultroute" >> /etc/ppp/peers/l2tp
    echo "persist" >> /etc/ppp/peers/l2tp

}


start() {
	start_init
	/etc/init.d/ipsec stop
    /etc/init.d/ipsec start
	/etc/init.d/xl2tpd restart

}
stop() {

    /etc/init.d/ipsec stop


    /etc/init.d/xl2tpd stop


    sed -i '/conn eaoinfo/d' /etc/ipsec.conf
    sed -i '/%any/d' /etc/ipsec.secrets
}

restart() {
    /etc/init.d/ipsec stop
    /etc/init.d/ipsec start
}

reload() {
    /etc/init.d/ipsec restart
}