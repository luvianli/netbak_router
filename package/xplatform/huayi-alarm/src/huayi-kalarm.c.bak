    case CNOTE_BRIDGE_LOW_SS:
        snprintf(syslog, 256, "master_bssid:%02x:%02x:%02x:%02x:%02x:%02x slave_bssid:%02x:%02x:%02x:%02x:%02x:%02x rssi:%d",
                 e->info.bridge_low_ss.bssid_master[0],
                 e->info.bridge_low_ss.bssid_master[1],
                 e->info.bridge_low_ss.bssid_master[2],
                 e->info.bridge_low_ss.bssid_master[3],
                 e->info.bridge_low_ss.bssid_master[4],
                 e->info.bridge_low_ss.bssid_master[5],
                 e->info.bridge_low_ss.bssid_slave[0],
                 e->info.bridge_low_ss.bssid_slave[1],
                 e->info.bridge_low_ss.bssid_slave[2],
                 e->info.bridge_low_ss.bssid_slave[3],
                 e->info.bridge_low_ss.bssid_slave[4],
                 e->info.bridge_low_ss.bssid_slave[5],
                 e->info.bridge_low_ss.rssi);
        break;
    case CNOTE_BRIDGE_LOW_SS_RECOV:
        snprintf(syslog, 256, "master_bssid:%02x:%02x:%02x:%02x:%02x:%02x slave_bssid:%02x:%02x:%02x:%02x:%02x:%02x rssi:%d",
                 e->info.bridge_low_ss.bssid_master[0],
                 e->info.bridge_low_ss.bssid_master[1],
                 e->info.bridge_low_ss.bssid_master[2],
                 e->info.bridge_low_ss.bssid_master[3],
                 e->info.bridge_low_ss.bssid_master[4],
                 e->info.bridge_low_ss.bssid_master[5],
                 e->info.bridge_low_ss.bssid_slave[0],
                 e->info.bridge_low_ss.bssid_slave[1],
                 e->info.bridge_low_ss.bssid_slave[2],
                 e->info.bridge_low_ss.bssid_slave[3],
                 e->info.bridge_low_ss.bssid_slave[4],
                 e->info.bridge_low_ss.bssid_slave[5],
                 e->info.bridge_low_ss.rssi);
        break;
    case CNOTE_RADIO_DOWN:
        snprintf(syslog, 256, "ap_macaddr:%02x:%02x:%02x:%02x:%02x:%02x device_id:%s reason:%s",
                 e->info.radio_down.ap_macaddr[0],
                 e->info.radio_down.ap_macaddr[1],
                 e->info.radio_down.ap_macaddr[2],
                 e->info.radio_down.ap_macaddr[3],
                 e->info.radio_down.ap_macaddr[4],
                 e->info.radio_down.ap_macaddr[5],
                 e->info.radio_down.device_id,
                 e->info.radio_down.reason);
        break;
    case CNOTE_RADIO_DOWN_RECOV:
        snprintf(syslog, 256, "ap_macaddr:%02x:%02x:%02x:%02x:%02x:%02x device_id:%s reason:%s",
                 e->info.radio_down_recov.ap_macaddr[0],
                 e->info.radio_down_recov.ap_macaddr[1],
                 e->info.radio_down_recov.ap_macaddr[2],
                 e->info.radio_down_recov.ap_macaddr[3],
                 e->info.radio_down_recov.ap_macaddr[4],
                 e->info.radio_down_recov.ap_macaddr[5],
                 e->info.radio_down_recov.device_id,
                 e->info.radio_down_recov.reason);
        break;
    case CNOTE_AP_BEACON_STUCK:
    case CNOTE_AP_BEACON_STUCK_CLEAR:
        snprintf(syslog, 256, "ap_macaddr:%02x:%02x:%02x:%02x:%02x:%02x device_id:%s reason:%s",
                 e->info.ap_bstuck.ap_macaddr[0],
                 e->info.ap_bstuck.ap_macaddr[1],
                 e->info.ap_bstuck.ap_macaddr[2],
                 e->info.ap_bstuck.ap_macaddr[3],
                 e->info.ap_bstuck.ap_macaddr[4],
                 e->info.ap_bstuck.ap_macaddr[5],
                 e->info.ap_bstuck.device_id,
                 e->info.ap_bstuck.reason);
        break;
    case CNOTE_AP_TXBUF_LEAK:
    case CNOTE_AP_TXBUF_LEAK_CLEAR:
        snprintf(syslog, 256, "ap_macaddr:%02x:%02x:%02x:%02x:%02x:%02x device_id:%s reason:%s",
                 e->info.ap_txbuf_leak.ap_macaddr[0],
                 e->info.ap_txbuf_leak.ap_macaddr[1],
                 e->info.ap_txbuf_leak.ap_macaddr[2],
                 e->info.ap_txbuf_leak.ap_macaddr[3],
                 e->info.ap_txbuf_leak.ap_macaddr[4],
                 e->info.ap_txbuf_leak.ap_macaddr[5],
                 e->info.ap_txbuf_leak.device_id,
                 e->info.ap_txbuf_leak.reason);
        break;
    default:
        snprintf(syslog, 256, "-");
        break;
    }
    return;
}

static void kalarm_syslog(const struct cms_notification *e) {
    switch (e->notification_id) {
    case CNOTE_STA_ASSOCIATION:
        ALARM_LOG(CMSLOG_INFO, "Asso - %s\n", s_alarm_syslog);
        break;
    }
    return;
}

static int kalarm_update_alarm(const struct cms_notification *e) {
    struct list_head *ptr, *n;
    struct cms_kalarm_alarm *entry;

    switch (e->notification_id) {
    case CNOTE_CPU_USAGE_TOO_HIGH:
    case CNOTE_MEM_USAGE_TOO_HIGH:
    case CNOTE_AP_STA_FULL:
    case CNOTE_SAFE_MODE_ON:
    case CNOTE_SYS_OVERHEAT:
    case CNOTE_BRIDGE_LOW_SS:
        /* raise alarm - system level */
        list_for_each(ptr, &s_kalarm.list_alarm) {
            entry = list_entry(ptr, struct cms_kalarm_alarm, list);
            if (e->notification_id == entry->alarm.notification_id) {
                // alarm already raised
                KALARM_LOG(CMSLOG_INFO, "alarm already raised(%d)\n",
                           e->notification_id);
                return 0;
            }
        }
        entry = CMS_MALLOC(sizeof(struct cms_kalarm_alarm));
        BCOPY((void*)e,(void*)&entry->alarm,sizeof(struct cms_notification));
        entry->alarm_id = s_kalarm.curr_alarm_id;
        s_kalarm.curr_alarm_id++;
        s_kalarm.active++;
        list_add_tail(&entry->list, &s_kalarm.list_alarm);
        ALARM_LOG(CMSLOG_INFO, "Alarm Raise - %s(%d) - %s\n",
                  CMS_NOTE_ID_TOSTR(e->notification_id), e->notification_id, s_alarm_syslog);
        break;
    case CNOTE_RADIO_DOWN:
    case CNOTE_AP_BEACON_STUCK:
    case CNOTE_AP_TXBUF_LEAK:
#if 0 // sammyc120919 - not support interference alarms
    case CNOTE_AP_CO_INTERF_DETECTED:
    case CNOTE_AP_NEIGHBOR_INTERF_DETECTED:
    case CNOTE_OTHER_DEV_INTERF_DETECTED:
    case CNOTE_STA_INTERF_DETECTED:
#endif
        /* raise alarm - device level */
        list_for_each(ptr, &s_kalarm.list_alarm) {
            entry = list_entry(ptr, struct cms_kalarm_alarm, list);
            if (e->notification_id == entry->alarm.notification_id &&
                strcmp(e->info.device.device_id, entry->alarm.info.device.device_id) == 0) {
                // alarm already raised
                KALARM_LOG(CMSLOG_INFO, "alarm already raised(%d) device(%s)\n",
                           e->notification_id, e->info.device.device_id);
                return 0;
            }
        }
        entry = CMS_MALLOC(sizeof(struct cms_kalarm_alarm));
        BCOPY((void*)e, (void*)&entry->alarm, sizeof(struct cms_notification));
        entry->alarm_id = s_kalarm.curr_alarm_id;
        snprintf(entry->alarm.info.device.device_id, CNOTE_MAX_DEVICE_ID,
                 "%s", e->info.device.device_id);
        s_kalarm.curr_alarm_id++;
        s_kalarm.active++;
        list_add_tail(&entry->list, &s_kalarm.list_alarm);
        ALARM_LOG(CMSLOG_INFO, "Alarm Raise - %s(%d) - %s\n",
                  CMS_NOTE_ID_TOSTR(e->notification_id), e->notification_id, s_alarm_syslog);
        break;
    case CNOTE_CPU_USAGE_TOO_HIGH_RECOV:
    case CNOTE_MEM_USAGE_TOO_HIGH_RECOV:
    case CNOTE_AP_STA_FULL_RECOVER:
    case CNOTE_SAFE_MODE_OFF:
    case CNOTE_SYS_OVERHEAT_RECOV:
    case CNOTE_BRIDGE_LOW_SS_RECOV:
        /* clear alarm - system level */
        list_for_each_safe(ptr, n, &s_kalarm.list_alarm) {
            entry = list_entry(ptr, struct cms_kalarm_alarm, list);
            // +1 match the raise event
            if (e->notification_id == (entry->alarm.notification_id+1)) {
                // alarm found
                s_kalarm.active--;
                list_del(&entry->list);
                CMS_FREE(entry);
                ALARM_LOG(CMSLOG_INFO, "Alarm Clear - %s(%d) - %s\n",
                          CMS_NOTE_ID_TOSTR(e->notification_id), e->notification_id, s_alarm_syslog);
                break;
            }
        }
        if (ptr == &s_kalarm.list_alarm) {
            // alarm already cleared
            KALARM_LOG(CMSLOG_INFO, "alarm already cleared(%d)\n",
                       e->notification_id);
            return 0;
        }
        break;
    case CNOTE_RADIO_DOWN_RECOV:
    case CNOTE_AP_BEACON_STUCK_CLEAR:
    case CNOTE_AP_TXBUF_LEAK_CLEAR:
#if 0 // sammyc120919 - not support interference alarms
    case CNOTE_AP_CO_INTERF_CLEAR:
    case CNOTE_AP_NEIGHBOR_INTERF_CLEAR:
    case CNOTE_OTHER_DEV_INTERF_CLEAR:
    case CNOTE_STA_INTERF_CLEAR:
#endif
        /* clear alarm - device level */
        list_for_each_safe(ptr, n, &s_kalarm.list_alarm) {
            entry = list_entry(ptr, struct cms_kalarm_alarm, list);
            // +1 match the raise event
            if (e->notification_id == (entry->alarm.notification_id+1) &&
                strcmp(e->info.device.device_id, entry->alarm.info.device.device_id) == 0) {
                // alarm found
                s_kalarm.active--;
                list_del(&entry->list);
                CMS_FREE(entry);
                ALARM_LOG(CMSLOG_INFO, "Alarm Clear - %s(%d) - %s\n",
                          CMS_NOTE_ID_TOSTR(e->notification_id), e->notification_id, s_alarm_syslog);
                break;
            }
        }
        if (ptr == &s_kalarm.list_alarm) {
            // alarm already cleared
            KALARM_LOG(CMSLOG_INFO, "alarm already cleared(%d)\n",
                       e->notification_id);
            return 0;
        }
        break;
    default:
        if (V) {
            KALARM_LOG(CMSLOG_DEBUG, "update status not supported for %d(%s)\n",
                    e->notification_id, CMS_NOTE_ID_TOCMD(e->notification_id));
        }
        break;
    }
    return 0;
}

static DAL_STATUS kalarm_raise_notification(struct cms_notification e) {
    int len;

    switch (e.notification_id) {
    case CNOTE_STA_ASSOCIATION:
        e.type = CNOTE_TYPE_STA;
        e.status = 0;
        break;
    case CNOTE_AP_FLASH_WRITE_FAIL:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_AP_MT_WORK_MODE_CHG:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_AP_OFFLINE:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 1;
        break;
    case CNOTE_AP_ONLINE:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_AP_SW_UPDATE_SUCC:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_AP_SW_UPDATE_FAIL:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_CONFIGURATION_UPDATE:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_CONFIGURATION_ERROR:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_HEARTBEAT:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_IP_ADDR_CHG:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_SSID_KEY_CONFLICT:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_SYS_COLD_START:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_SYS_WARM_START:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_SYS_REBOOT:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_CPU_USAGE_TOO_HIGH_RECOV:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 1;
        break;
    case CNOTE_CPU_USAGE_TOO_HIGH:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_MEM_USAGE_TOO_HIGH_RECOV:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 1;
        break;
    case CNOTE_MEM_USAGE_TOO_HIGH:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_NTP_TIMESYNC_FAIL:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_SAFE_MODE_ON:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_SAFE_MODE_OFF:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 1;
        break;
    case CNOTE_SYS_OVERHEAT:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_SYS_OVERHEAT_RECOV:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 1;
        break;
    case CNOTE_BRIDGE_HEARTBEAT:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_BRIDGE_LOW_SS:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_BRIDGE_LOW_SS_RECOV:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 1;
        break;
    case CNOTE_BRIDGE_CONNECTED:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_BRIDGE_DISCONNECTED:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_ADDRESS_REDIRECTION_ATTACK:
        e.type = CNOTE_TYPE_WAPI;
        e.status = 0;
        break;
    case CNOTE_LOW_SAFE_LEVEL_ATTACK:
        e.type = CNOTE_TYPE_WAPI;
        e.status = 0;
        break;
    case CNOTE_STA_REPITITIVE_ATTACK:
        e.type = CNOTE_TYPE_WAPI;
        e.status = 0;
        break;
    case CNOTE_TAMPER_ATTACK:
        e.type = CNOTE_TYPE_WAPI;
        e.status = 0;
        break;
    case CNOTE_USER_WITH_INVALID_CERT_INBREAK_NETWORK:
        e.type = CNOTE_TYPE_WAPI;
        e.status = 0;
        break;
    case CNOTE_DETECT_ROGUE:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_AP_CHANNEL_CHG:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_RADIO_DOWN_RECOV:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 1;
        break;
    case CNOTE_RADIO_DOWN:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_AP_STA_FULL_RECOVER:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 1;
        break;
    case CNOTE_AP_STA_FULL:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_AP_CO_INTERF_CLEAR:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 1;
        break;
    case CNOTE_AP_CO_INTERF_DETECTED:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_AP_NEIGHBOR_INTERF_CLEAR:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 1;
        break;
    case CNOTE_AP_NEIGHBOR_INTERF_DETECTED:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_OTHER_DEV_INTERF_CLEAR:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 1;
        break;
    case CNOTE_OTHER_DEV_INTERF_DETECTED:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_STA_INTERF_CLEAR:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 1;
        break;
    case CNOTE_STA_INTERF_DETECTED:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_CHANNEL_SCAN_COMPLETED:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_WIRELESS_INSTRUSION_DETECTED:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_STA_UPLINK_BW_OVERRUN:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_STA_UPLINK_BW_OVERRUN_RECOV:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 1;
        break;
    case CNOTE_STA_DNLINK_BW_OVERRUN:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_STA_DNLINK_BW_OVERRUN_RECOV:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 1;
        break;
    case CNOTE_AP_THINAP_KEEP_ALIVE:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
    case CNOTE_AP_BEACON_STUCK:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_AP_BEACON_STUCK_CLEAR:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 1;
        break;
    case CNOTE_AP_TXBUF_LEAK:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 0;
        break;
    case CNOTE_AP_TXBUF_LEAK_CLEAR:
        e.type = CNOTE_TYPE_WIRELESS;
        e.status = 1;
        break;
	case CNOTE_BUTTON_PRESS:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
	case CNOTE_BUTTON_RELEASE:
        e.type = CNOTE_TYPE_SYSTEM;
        e.status = 0;
        break;
	case CNOTE_AP_LOCATION_BEGIN:
		e.type = CNOTE_TYPE_SYSTEM;
		e.status = 0;
		break;
	case CNOTE_AP_LOCATION_END:
		e.type = CNOTE_TYPE_SYSTEM;
		e.status = 0;
		break;
    default:
        // not supported notification_id
        KALARM_LOG(CMSLOG_EMERG, "notification ID %d (%s) not supported\n",
                   e.notification_id, CMS_NOTE_ID_TOCMD(e.notification_id));
        return DAL_ERROR;
    }

    kalarm_alarm_tosyslog(&e, s_alarm_syslog);

    kalarm_syslog(&e);

    // update alarm status
    kalarm_update_alarm(&e);
    if (V) {
        KALARM_LOG(CMSLOG_NOTICE, "notification %d(%s)\n",
               e.notification_id, CMS_NOTE_ID_TOSTR(e.notification_id));
    }

    len = cms_events_send(s_kalarm.event_handle,
                           CMS_EVENTS_NOTE, (char*)&e, sizeof(e));
    if (len != sizeof(e)) {
        KALARM_LOG("sending size(%d) does not match the event size(%u)\n",
                   len, sizeof(e));
    }
    return DAL_OK;
}

static ssize_t kalarm_proc_write(struct file *file, const char *buffer,
                                 size_t count, loff_t *data) {
    int ret;
    char str[CMS_PROC_MAX_BUFFER];
    struct cms_notification e;
    char *pEnd;
    char *pStr;
    int nid;
    struct timex txc;

    BZERO((void*)&e, sizeof(struct cms_notification));
    do_gettimeofday(&(txc.time));
#if LINUX_VERSION_CODE >= KERNEL_VERSION(2,6,32)
    e.time = txc.time.tv_sec;
#else
    e.time = txc.time.tv_sec - (sys_tz.tz_minuteswest * 60);
#endif

    ret = cms_proc_write_string(file, buffer, count, str);
    nid = simple_strtol(str, &pEnd, 10);
    pStr = strsep(&pEnd, "\n");
    pEnd = pStr;
    switch(nid) {
    case CNOTE_AP_MT_WORK_MODE_CHG:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.ap_mt_work_mode_chg.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'd':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    snprintf(e.info.ap_mt_work_mode_chg.device_id, CNOTE_MAX_DEVICE_ID, "%s", pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'p':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%hhu", &(e.info.ap_mt_work_mode_chg.pre_monitor_mode));
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'c':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%hhu", &(e.info.ap_mt_work_mode_chg.cur_monitor_mode));
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_AP_OFFLINE:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.ap_offline.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_AP_ONLINE:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.ap_online.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_AP_SW_UPDATE_SUCC:
        // no parameters
        break;
    case CNOTE_AP_SW_UPDATE_FAIL:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'v':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    snprintf(e.info.ap_sw_update_fail.current_fw_ver, CNOTE_MAX_VERSION, "%s", pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'u':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    snprintf(e.info.ap_sw_update_fail.update_fw_ver, CNOTE_MAX_VERSION, "%s", pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'f':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    snprintf(e.info.ap_sw_update_fail.filename, CNOTE_MAX_FILENAME, "%s", pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'r':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    snprintf(e.info.ap_sw_update_fail.fail_reason, CNOTE_MAX_REASON, "%s", pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_CONFIGURATION_UPDATE:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'c':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    snprintf(e.info.configuration_update.config, CNOTE_MAX_CONFIG, "%s", pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_CONFIGURATION_ERROR:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'c':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    snprintf(e.info.configuration_error.config, CNOTE_MAX_CONFIG, "%s", pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_HEARTBEAT:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'i':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    e.info.heartbeat.ip_addr = A_INET_ADDR(pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_IP_ADDR_CHG:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'p':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    e.info.ip_addr_chg.pre_ip_addr = A_INET_ADDR(pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'c':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    e.info.ip_addr_chg.cur_ip_addr = A_INET_ADDR(pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        //printk("cur "NIPQUAD_FMT"\n",NIPQUAD(e.info.ip_addr_chg.cur_ip_addr));
        //printk("pre "NIPQUAD_FMT"\n",NIPQUAD(e.info.ip_addr_chg.pre_ip_addr));
        break;
    case CNOTE_SSID_KEY_CONFLICT:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.ssid_key_conflict.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'd':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    snprintf(e.info.ssid_key_conflict.device_id, CNOTE_MAX_DEVICE_ID, "%s", pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'v':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%hhu", &(e.info.ssid_key_conflict.vap_id1));
                    if (e.info.ssid_key_conflict.vap_id1 < 0) {
                        e.info.ssid_key_conflict.vap_id1 = 0;
                    }
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'w':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%hhu", &(e.info.ssid_key_conflict.vap_id2));
                    if (e.info.ssid_key_conflict.vap_id2 < 0) {
                        e.info.ssid_key_conflict.vap_id2 = 0;
                    }
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'b':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.ssid_key_conflict.bssid1, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'c':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.ssid_key_conflict.bssid2, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_SYS_COLD_START:
        // no parameters
        break;
    case CNOTE_SYS_WARM_START:
        // no parameters
        break;
    case CNOTE_SYS_REBOOT:
        // no parameters
        break;
    case CNOTE_CPU_USAGE_TOO_HIGH:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.cpu_usage_too_high.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'u':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%hhu", &(e.info.cpu_usage_too_high.cpu_usage));
                    if (e.info.cpu_usage_too_high.cpu_usage > 100) {
                        e.info.cpu_usage_too_high.cpu_usage = 100;
                    } else if (e.info.cpu_usage_too_high.cpu_usage < 0) {
                        e.info.cpu_usage_too_high.cpu_usage = 0;
                    }
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_CPU_USAGE_TOO_HIGH_RECOV:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.cpu_usage_too_high_recov.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'u':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%hhu", &(e.info.cpu_usage_too_high_recov.cpu_usage));
                    if (e.info.cpu_usage_too_high_recov.cpu_usage > 100) {
                        e.info.cpu_usage_too_high_recov.cpu_usage = 100;
                    } else if (e.info.cpu_usage_too_high_recov.cpu_usage < 0) {
                        e.info.cpu_usage_too_high_recov.cpu_usage = 0;
                    }
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_MEM_USAGE_TOO_HIGH:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.mem_usage_too_high.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'u':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%hhu", &(e.info.mem_usage_too_high.mem_usage));
                    if (e.info.mem_usage_too_high.mem_usage > 100) {
                        e.info.mem_usage_too_high.mem_usage = 100;
                    } else if (e.info.mem_usage_too_high.mem_usage < 0) {
                        e.info.mem_usage_too_high.mem_usage = 0;
                    }
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_MEM_USAGE_TOO_HIGH_RECOV:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.mem_usage_too_high_recov.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'u':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%hhu", &(e.info.mem_usage_too_high_recov.mem_usage));
                    if (e.info.mem_usage_too_high_recov.mem_usage > 100) {
                        e.info.mem_usage_too_high_recov.mem_usage = 100;
                    } else if (e.info.mem_usage_too_high_recov.mem_usage < 0) {
                        e.info.mem_usage_too_high_recov.mem_usage = 0;
                    }
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_NTP_TIMESYNC_FAIL:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.ntp_timesync_fail.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_SAFE_MODE_ON:
    case CNOTE_SAFE_MODE_OFF:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'r':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    snprintf(e.info.safe_mode.reason, CNOTE_MAX_REASON, "%s", pStr);
                    pStr = strsep(&pEnd, " ");
                }
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_SYS_OVERHEAT:
    case CNOTE_SYS_OVERHEAT_RECOV:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.sys_overheat.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'v':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%u", &(e.info.sys_overheat.temperature));
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 't':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%u", &(e.info.sys_overheat.threshold));
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_BRIDGE_HEARTBEAT:
    case CNOTE_BRIDGE_CONNECTED:
    case CNOTE_BRIDGE_DISCONNECTED:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.bridge_heartbeat.bssid_master, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 's':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.bridge_heartbeat.bssid_slave, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_BRIDGE_LOW_SS:
    case CNOTE_BRIDGE_LOW_SS_RECOV:
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.bridge_low_ss.bssid_master, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 's':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.bridge_low_ss.bssid_slave, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'r':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    sscanf(pStr, "%hhd", &(e.info.bridge_low_ss.rssi));
                    pStr = strsep(&pEnd, " ");
                }
                break;
            default:
                pStr = strsep(&pEnd, " ");
                break;
            }
        }
        break;
    case CNOTE_AP_CHANNEL_CHG:
        e.info.ap_channel_chg.change_mode = CNOTE_MANUAL;
        pStr = strsep(&pEnd, " ");
        while (pStr != NULL) {
            if (*pStr != '-') {
                pStr = strsep(&pEnd, " ");
                continue;
            }
            pStr++;

            switch (*pStr) {
            case 'm':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    A_MACADDR_FROMSTR((A_MACADDR*)e.info.ap_channel_chg.ap_macaddr, pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'd':
                pStr = strsep(&pEnd, " ");
                if (pStr != NULL) {
                    snprintf(e.info.ap_channel_chg.device_id, CNOTE_MAX_DEVICE_ID, "%s", pStr);
                    pStr = strsep(&pEnd, " ");
                }
                break;
            case 'w':
                pStr = strsep(&pEnd, " ");
