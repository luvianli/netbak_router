static char s_alarm_syslog[256];
static void kalarm_alarm_tosyslog(const struct cms_notification *e, char* syslog) {
    switch (e->notification_id) {
    case CNOTE_STA_ASSOCIATION:
        snprintf(syslog, 256, "[%s:%d] %02x:%02x:%02x:%02x:%02x:%02x [%s:%d] [%d %d %d %d]",
                 e->info.sta_association.device_id,
                 e->info.sta_association.vap_id,
                 e->info.sta_association.client_macaddr[0],
                 e->info.sta_association.client_macaddr[1],
                 e->info.sta_association.client_macaddr[2],
                 e->info.sta_association.client_macaddr[3],
                 e->info.sta_association.client_macaddr[4],
                 e->info.sta_association.client_macaddr[5],
                 CMS_NOTE_ASSOSTAT_TOSTR(e->info.sta_association.status),
                 e->info.sta_association.reason_code,
                 e->info.sta_association.auth_mode,
                 e->info.sta_association.channel,
                 e->info.sta_association.rssi,
                 e->info.sta_association.qos);
        break;
    case CNOTE_CPU_USAGE_TOO_HIGH:
        snprintf(syslog, 256, "ap_macaddr:%02x:%02x:%02x:%02x:%02x:%02x cpu_usage:%u",
                 e->info.cpu_usage_too_high.ap_macaddr[0],
                 e->info.cpu_usage_too_high.ap_macaddr[1],
                 e->info.cpu_usage_too_high.ap_macaddr[2],
                 e->info.cpu_usage_too_high.ap_macaddr[3],
                 e->info.cpu_usage_too_high.ap_macaddr[4],
                 e->info.cpu_usage_too_high.ap_macaddr[5],
                 e->info.cpu_usage_too_high.cpu_usage);
        break;
    case CNOTE_CPU_USAGE_TOO_HIGH_RECOV:
        snprintf(syslog, 256, "ap_macaddr:%02x:%02x:%02x:%02x:%02x:%02x cpu_usage:%u",
                 e->info.cpu_usage_too_high_recov.ap_macaddr[0],
                 e->info.cpu_usage_too_high_recov.ap_macaddr[1],
                 e->info.cpu_usage_too_high_recov.ap_macaddr[2],
                 e->info.cpu_usage_too_high_recov.ap_macaddr[3],
                 e->info.cpu_usage_too_high_recov.ap_macaddr[4],
                 e->info.cpu_usage_too_high_recov.ap_macaddr[5],
                 e->info.cpu_usage_too_high_recov.cpu_usage);
        break;
    case CNOTE_MEM_USAGE_TOO_HIGH:
        snprintf(syslog, 256, "ap_macaddr:%02x:%02x:%02x:%02x:%02x:%02x -u mem_usage:%u",
                 e->info.mem_usage_too_high.ap_macaddr[0],
                 e->info.mem_usage_too_high.ap_macaddr[1],
                 e->info.mem_usage_too_high.ap_macaddr[2],
                 e->info.mem_usage_too_high.ap_macaddr[3],
                 e->info.mem_usage_too_high.ap_macaddr[4],
                 e->info.mem_usage_too_high.ap_macaddr[5],
                 e->info.mem_usage_too_high.mem_usage);
        break;
    case CNOTE_MEM_USAGE_TOO_HIGH_RECOV:
        snprintf(syslog, 256, "ap_macaddr:%02x:%02x:%02x:%02x:%02x:%02x mem_usage:%u",
                 e->info.mem_usage_too_high_recov.ap_macaddr[0],
                 e->info.mem_usage_too_high_recov.ap_macaddr[1],
                 e->info.mem_usage_too_high_recov.ap_macaddr[2],
                 e->info.mem_usage_too_high_recov.ap_macaddr[3],
                 e->info.mem_usage_too_high_recov.ap_macaddr[4],
                 e->info.mem_usage_too_high_recov.ap_macaddr[5],
                 e->info.mem_usage_too_high_recov.mem_usage);
        break;
    case CNOTE_AP_STA_FULL:
        snprintf(syslog, 256, "max_asso_client:%d reason:%s",
                 e->info.ap_sta_full.max_asso_client,
                 e->info.ap_sta_full.reason);
        break;
    case CNOTE_AP_STA_FULL_RECOVER:
        snprintf(syslog, 256, "max_asso_client:%d reason:%s",
                 e->info.ap_sta_full_recover.max_asso_client,
                 e->info.ap_sta_full_recover.reason);
        break;
    case CNOTE_SAFE_MODE_ON:
        snprintf(syslog, 256, "reason:%s",
                 e->info.safe_mode.reason);
        break;
    case CNOTE_SAFE_MODE_OFF:
        snprintf(syslog, 256, "reason:%s",
                 e->info.safe_mode.reason);
        break;
    case CNOTE_SYS_OVERHEAT:
        snprintf(syslog, 256, "ap_macaddr:%02x:%02x:%02x:%02x:%02x:%02x temperature:%u threshold:%u",
                 e->info.sys_overheat.ap_macaddr[0],
                 e->info.sys_overheat.ap_macaddr[1],
                 e->info.sys_overheat.ap_macaddr[2],
                 e->info.sys_overheat.ap_macaddr[3],
                 e->info.sys_overheat.ap_macaddr[4],
                 e->info.sys_overheat.ap_macaddr[5],
                 e->info.sys_overheat.temperature,
                 e->info.sys_overheat.threshold);
        break;
    case CNOTE_SYS_OVERHEAT_RECOV:
        snprintf(syslog, 256, "ap_macaddr:%02x:%02x:%02x:%02x:%02x:%02x temperature:%u threshold:%u",
                 e->info.sys_overheat.ap_macaddr[0],
                 e->info.sys_overheat.ap_macaddr[1],
                 e->info.sys_overheat.ap_macaddr[2],
                 e->info.sys_overheat.ap_macaddr[3],
                 e->info.sys_overheat.ap_macaddr[4],
                 e->info.sys_overheat.ap_macaddr[5],
                 e->info.sys_overheat.temperature,
                 e->info.sys_overheat.threshold);
