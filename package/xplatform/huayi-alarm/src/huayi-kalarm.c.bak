        KALARM_LOG("non-supported notification %d (userspace)\n", nid);
        return ret;
    }
    e.notification_id = nid;
    kalarm_raise_notification(e);
    return ret;
}

static void *kalarm_seq_start(struct seq_file *seq, loff_t *pos)
{
    if (*pos == 0) {
        return SEQ_START_TOKEN;
    }

    if (*pos < CNOTE_MAX_ID) {
        return pos;
    }
    return NULL;
}
static void *kalarm_seq_next(struct seq_file *s, void *v, loff_t *pos)
{
    if (v == SEQ_START_TOKEN) {
        return pos;
    }
    ++*pos;
    if (*pos < CNOTE_MAX_ID) {
        return pos;
    }
    return NULL;
}
static void kalarm_seq_stop(struct seq_file *s, void *v)
{
	/* nothing to do (release), we use pos directly */
}
static int kalarm_seq_show(struct seq_file *s, void *v)
{
    loff_t *pos;

    if (v == SEQ_START_TOKEN) {
        // print header here
        return 0;
    }

    pos = (loff_t *) v;
    seq_printf(s, "%lld:%s:%s:%s\n", *pos,
               CMS_NOTE_ID_TOCMD(*pos),
               CMS_NOTE_ID_TOUSAGE(*pos),
               CMS_NOTE_ID_TOSTR(*pos));
    return 0;
}

static struct seq_operations kalarm_seq_ops = {
    .start = kalarm_seq_start,
    .next = kalarm_seq_next,
    .stop = kalarm_seq_stop,
    .show = kalarm_seq_show
};

int kalarm_proc_open(struct inode *inode, struct file *file)
{
    return seq_open(file, &kalarm_seq_ops);
}

static struct file_operations kalarm_proc_fops = {
    .owner = THIS_MODULE,
    .open = kalarm_proc_open,
    .read = seq_read,
    .write = kalarm_proc_write,
    .llseek = seq_lseek,
    .release = seq_release
};

static void* seq_next_status_alarm(struct seq_file *s, void *v, loff_t *pos);
static void* seq_start_status_alarm(struct seq_file *s, loff_t *pos) {
    if (*pos == 0) {
        s->private = (void*)&(s_kalarm.list_alarm);
        return s->private;
    }
    return seq_next_status_alarm(s, NULL, pos);
}

static void* seq_next_status_alarm(struct seq_file *s, void *v, loff_t *pos) {
    struct list_head *ptr = (struct list_head*)s->private;

    if (ptr == NULL) {
        KALARM_LOG(CMSLOG_ERR,"invalid ptr in status_alarm next\n");
        return NULL;
    }
    if (ptr->next == &(s_kalarm.list_alarm)) {
        // no next
        return NULL;
    }
    s->private = (void*)ptr->next;
    return s->private;
}

static void seq_stop_status_alarm(struct seq_file *s, void *v) {
}

static int seq_show_status_alarm(struct seq_file *s, void *v) {
#define MAC_FMT "%02x:%02x:%02x:%02x:%02x:%02x"
#define MAC_ARG(x) \
((u8*)(x))[0],((u8*)(x))[1],\
((u8*)(x))[2],((u8*)(x))[3],\
((u8*)(x))[4],((u8*)(x))[5]

    struct cms_kalarm_alarm *entry;
    struct list_head *ptr = (struct list_head*)s->private;

    // from seq_start_status_alarm, print general
    if (ptr == &(s_kalarm.list_alarm)) {
        seq_printf(s, "config 'general' 'general'\n");
        seq_printf(s, "        option 'active' '%d'\n", s_kalarm.active);
        seq_printf(s, "\n");
        return 0;
    }

    if (ptr == NULL) {
        KALARM_LOG(CMSLOG_ERR,"invalid ptr in status_alarm show\n");
        return 1;
    }
    entry = list_entry(ptr, struct cms_kalarm_alarm, list);
    if (entry == NULL) {
        KALARM_LOG(CMSLOG_ERR,"cannot get list data in status_alarm show\n");
        return 1;
    }

    seq_printf(s, "config 'alarm' 'alarm_%d'\n", entry->alarm_id);
    seq_printf(s, "        option 'id' '%d'\n", entry->alarm_id);
    seq_printf(s, "        option 'nid' '%d'\n", entry->alarm.notification_id);
    seq_printf(s, "        option 'description' '%s(%d)'\n",
               CMS_NOTE_ID_TOSTR(entry->alarm.notification_id),
               entry->alarm.notification_id);
    seq_printf(s, "        option 'type' '%d'\n", entry->alarm.type);
    seq_printf(s, "        option 'timestamp' '%ld'\n", entry->alarm.time);
    seq_printf(s, "        option 'status' '%lld'\n", entry->alarm.status);
    seq_printf(s, "        option 'cause' '%s'\n", entry->alarm.reason);

    switch (entry->alarm.notification_id) {
    case CNOTE_CPU_USAGE_TOO_HIGH:
        seq_printf(s, "        option 'ap_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.cpu_usage_too_high.ap_macaddr));
        seq_printf(s, "        option 'cpu_usage' '%d'\n",
                   entry->alarm.info.cpu_usage_too_high.cpu_usage);
        break;
    case CNOTE_MEM_USAGE_TOO_HIGH:
        seq_printf(s, "        option 'ap_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.mem_usage_too_high.ap_macaddr));
        seq_printf(s, "        option 'mem_usage' '%d'\n",
                   entry->alarm.info.mem_usage_too_high.mem_usage);
        break;
    case CNOTE_SAFE_MODE_ON:
        seq_printf(s, "        option 'reason' '%s\n",
                   entry->alarm.info.safe_mode.reason);
        break;
    case CNOTE_RADIO_DOWN:
        seq_printf(s, "        option 'ap_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.radio_down.ap_macaddr));
        seq_printf(s, "        option 'device_id' '%s'\n",
                   entry->alarm.info.radio_down.device_id);
        seq_printf(s, "        option 'reason' '%s'\n",
                   entry->alarm.info.radio_down.reason);
        break;
    case CNOTE_AP_STA_FULL:
        seq_printf(s, "        option 'max_asso_client' '%d'\n",
                   entry->alarm.info.ap_sta_full.max_asso_client);
        seq_printf(s, "        option 'reason' '%s'\n",
                   entry->alarm.info.ap_sta_full.reason);
        break;
    case CNOTE_SYS_OVERHEAT:
        seq_printf(s, "        option 'ap_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.sys_overheat.ap_macaddr));
        seq_printf(s, "        option 'temperature' '%d'\n",
                   entry->alarm.info.sys_overheat.temperature);
        seq_printf(s, "        option 'threshold' '%d'\n",
                   entry->alarm.info.sys_overheat.threshold);
        break;
    case CNOTE_BRIDGE_LOW_SS:
        seq_printf(s, "        option 'bssid_master' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.bridge_low_ss.bssid_master));
        seq_printf(s, "        option 'bssid_slave' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.bridge_low_ss.bssid_slave));
        seq_printf(s, "        option 'rssi' '%d'\n",
                   entry->alarm.info.bridge_low_ss.rssi);
        break;
    case CNOTE_AP_CO_INTERF_DETECTED:
        seq_printf(s, "        option 'ap_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.ap_co_interf_detected.ap_macaddr));
        seq_printf(s, "        option 'device_id' '%s'\n",
                   entry->alarm.info.ap_co_interf_detected.device_id);
        seq_printf(s, "        option 'channel' '%d'\n",
                   entry->alarm.info.ap_co_interf_detected.channel);
        seq_printf(s, "        option 'bssid' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.ap_co_interf_detected.bssid));
        break;
    case CNOTE_AP_NEIGHBOR_INTERF_DETECTED:
        seq_printf(s, "        option 'ap_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.ap_neighbor_interf_detected.ap_macaddr));
        seq_printf(s, "        option 'device_id' '%s'\n",
                   entry->alarm.info.ap_neighbor_interf_detected.device_id);
        seq_printf(s, "        option 'self_channel' '%d'\n",
                   entry->alarm.info.ap_neighbor_interf_detected.self_channel);
        seq_printf(s, "        option 'other_channel' '%d'\n",
                   entry->alarm.info.ap_neighbor_interf_detected.other_channel);
        seq_printf(s, "        option 'bssid' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.ap_neighbor_interf_detected.bssid));
        break;
    case CNOTE_OTHER_DEV_INTERF_DETECTED:
        seq_printf(s, "        option 'ap_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.other_dev_interf_detected.ap_macaddr));
        seq_printf(s, "        option 'device_id' '%s'\n",
                   entry->alarm.info.other_dev_interf_detected.device_id);
        seq_printf(s, "        option 'channel' '%d'\n",
                   entry->alarm.info.other_dev_interf_detected.channel);
        break;
    case CNOTE_STA_INTERF_DETECTED:
        seq_printf(s, "        option 'ap_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.sta_interf_detected.ap_macaddr));
        seq_printf(s, "        option 'device_id' '%s'\n",
                   entry->alarm.info.sta_interf_detected.device_id);
        seq_printf(s, "        option 'channel' '%d'\n",
                   entry->alarm.info.sta_interf_detected.channel);
        seq_printf(s, "        option 'client_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.sta_interf_detected.client_macaddr));
        break;
    case CNOTE_STA_UPLINK_BW_OVERRUN:
    case CNOTE_STA_UPLINK_BW_OVERRUN_RECOV:
    case CNOTE_STA_DNLINK_BW_OVERRUN:
    case CNOTE_STA_DNLINK_BW_OVERRUN_RECOV:
        seq_printf(s, "        option 'client_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.sta_bandwidth_overrun.client_macaddr));
        seq_printf(s, "        option 'bssid' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.sta_bandwidth_overrun.bssid));
        seq_printf(s, "        option 'ssid' '%s'\n",
                   entry->alarm.info.sta_bandwidth_overrun.ssid);
        seq_printf(s, "        option 'throughput' '%d'\n",
                   entry->alarm.info.sta_bandwidth_overrun.throughput);
        seq_printf(s, "        option 'threshold' '%d'\n",
                   entry->alarm.info.sta_bandwidth_overrun.threshold);
        break;
    case CNOTE_AP_BEACON_STUCK:
        seq_printf(s, "        option 'ap_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.ap_bstuck.ap_macaddr));
        seq_printf(s, "        option 'device_id' '%s'\n",
                   entry->alarm.info.ap_bstuck.device_id);
        seq_printf(s, "        option 'reason' '%s'\n",
                   entry->alarm.info.ap_bstuck.reason);
        break;
    case CNOTE_AP_TXBUF_LEAK:
        seq_printf(s, "        option 'ap_macaddr' '"MAC_FMT"'\n",
                   MAC_ARG(entry->alarm.info.ap_txbuf_leak.ap_macaddr));
        seq_printf(s, "        option 'device_id' '%s'\n",
                   entry->alarm.info.ap_txbuf_leak.device_id);
        seq_printf(s, "        option 'reason' '%s'\n",
                   entry->alarm.info.ap_txbuf_leak.reason);
        break;
    default:
        KALARM_LOG("unsupported alarm in status_alarm show %d\n",
                   entry->alarm.notification_id);
        return 1;  // return error
    }
    seq_printf(s, "\n");

    // buffer full, move iterator backward
    if (s->count == s->size) {
        s->private = ptr->prev;
    }
    return 0;
#undef MAC_FMT
#undef MAC_ARG
}

static struct seq_operations seq_ops_status_alarm = {
    .start = seq_start_status_alarm,
    .next  = seq_next_status_alarm,
    .stop  = seq_stop_status_alarm,
    .show  = seq_show_status_alarm
};

static int fops_open_status_alarm(struct inode *inode, struct file *file) {
    return seq_open(file, &seq_ops_status_alarm);
}

static struct file_operations proc_fops_status_alarm = {
    .owner = THIS_MODULE,
    .open = fops_open_status_alarm,
    .read = seq_read,
    .llseek = seq_lseek,
    .release = seq_release
};

static struct dal_kalarm_hooks kalarm_hooks = {
    .raise_notification = kalarm_raise_notification,
};

static int kalarm_events_cb(char* buf, uint32_t len) {
    // not using
    return 1;
}

static void kalarm_init(void) {
    CMS_EVENTS_TYPE eid[1] = {CMS_EVENTS_NOTE};

	// alarm list
    s_kalarm.curr_alarm_id = 0;
    s_kalarm.active = 0;
    INIT_LIST_HEAD(&s_kalarm.list_alarm);
    // proc
    s_kalarm.proc_kalarm = proc_create(CMS_MODULE_KALARM,
                                       CMS_PROC_PERM, cms_proc,
                                       &kalarm_proc_fops);
    if (s_kalarm.proc_kalarm == NULL) {
        KALARM_LOG(CMSLOG_CRIT, "Initialize /proc/%s/%s failed\n",
                   CMS_PROC_ROOT, CMS_MODULE_KALARM);
        return;
    }

    s_kalarm.proc_status = create_proc_entry(CMS_KALARM_PROC_STATUS,
                                      CMS_PROC_PERM, cms_status_proc);
    if (s_kalarm.proc_status == NULL) {
        KALARM_LOG(CMSLOG_CRIT, "Initialize /proc/%s/%s/%s failed\n",
                   CMS_PROC_ROOT, CMS_PROC_STATUS, CMS_KALARM_PROC_STATUS);
        return;
    }
    s_kalarm.proc_status->proc_fops = &proc_fops_status_alarm;


    // event hook
    s_kalarm.event_handle = cms_events_create(kalarm_events_cb);
    cms_events_add(eid, 1, s_kalarm.event_handle);
    dal_attach_kalarm_hooks(&kalarm_hooks);
    return;
}

static void kalarm_deinit(void) {
    struct cms_kalarm_alarm* entry;

    // event hook
    CMS_EVENTS_TYPE eid[1] = {CMS_EVENTS_NOTE};
    cms_events_del(eid, 1, s_kalarm.event_handle);
    cms_events_destroy(s_kalarm.event_handle);
    dal_detach_kalarm_hooks();

    // proc
    if (s_kalarm.proc_status != NULL) {
        remove_proc_entry(CMS_KALARM_PROC_STATUS, cms_status_proc);
        s_kalarm.proc_status = NULL;
    }
    if (s_kalarm.proc_kalarm != NULL) {
        remove_proc_entry(CMS_MODULE_KALARM, cms_proc);
        s_kalarm.proc_kalarm = NULL;
    }

    // alarm list
    while (!list_empty(&(s_kalarm.list_alarm))) {
        entry = list_entry(s_kalarm.list_alarm.next,
                           struct cms_kalarm_alarm, list);
        list_del(s_kalarm.list_alarm.next);
        CMS_FREE(entry);
    }

    return;
}

static int __init module_kalarm_init(void)
{
    KALARM_LOG(CMSLOG_EMERG, "Alarm Module Init\n");
    kalarm_init();
    return 0;
}
module_init(module_kalarm_init);

static void __exit module_kalarm_exit(void)
{
    KALARM_LOG(CMSLOG_EMERG, "Alarm Module Exit\n");
    kalarm_deinit();
    return;
}
module_exit(module_kalarm_exit);

