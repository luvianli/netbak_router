#START=98

USE_PROCD=1
PROG=/usr/bin/huayi_dial4g


start_service() {
#	strategy=`uci get system.opmode.strategy`
#	mode=`uci get system.opmode.mode`
	
#	if [ $strategy -eq 2 -o $mode -ne 1 ]
#	then
#		return
#	fi
	echo "procd_open_instance"
    procd_open_instance
	echo "procd_set_param command /usr/bin/huayi_dial4g"
	procd_set_param command "$PROG" 
	echo "procd_set_param respawn 0"
	procd_set_param respawn 0
	echo "procd_close_instance"
	procd_close_instance
}

stop_service(){
	echo "service_stop /usr/bin/huayi_dial4g"
	service_stop "$PROG"
}
