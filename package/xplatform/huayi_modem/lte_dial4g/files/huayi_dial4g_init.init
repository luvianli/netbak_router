START=92

USE_PROCD=1
PROG=/usr/bin/huayi_dial4g_init


start_service() {
    #procd_open_instance
	#procd_set_param command "$PROG" 
	#procd_set_param respawn 0
	#procd_close_instance
	/usr/bin/huayi_dial4g_init &
}

stop_service(){
	#service_stop "$PROG"
	killall -9 huayi_dial4g_init
}
