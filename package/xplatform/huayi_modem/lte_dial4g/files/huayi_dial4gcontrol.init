#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2011 OpenWrt.org

#START=98

USE_PROCD=1

APP=`which huayi_dial4g`

DEV_ATC="/dev/ttyUSB1"
NET_IFACE="eth1"
wan_ifname=$(uci get network.wan4g.ifname)


quectel_EC20="05c6:9003"
quectel_EC20_2="05c6:9215"
quectel_VID="2c7c:0125"
quectel_E200T="2c7c:6026"
quectel_E200A="2c7c:6005"
neoway_N720V5_V1="2949:8700"
lynq_L509="1286:4e3c"

quectel_model_1_support=`lsusb | grep $quectel_VID`
quectel_model_2_support=`lsusb | grep $quectel_EC20`
quectel_model_3_support=`lsusb | grep $quectel_E200T`
quectel_model_4_support=`lsusb | grep $quectel_E200A`
neoway_model_1_support=`lsusb | grep $neoway_N720V5_V1`
lynq_model_1_support=`lsusb | grep $lynq_L509`

quectel_dev_name=`ifconfig -a | grep usb0`


start_service() {

	wan_type=`uci get system.mode.wan_type`
	
	if [ "$wan_type" == "mobile" ]; then
		huayi_cmd set network wan_link 0
	fi
	
	huayi_cmd set modem signal 0
	huayi_cmd set modem registStatus idle
	huayi_cmd set modem imei ''
	huayi_cmd set modem imsi ''
	huayi_cmd set modem phoneNumber ''
	
	insmod usbnet.ko
	insmod cdc_subset.ko
	
	if [ -n "$quectel_model_1_support""$quectel_model_2_support" ]; then
		echo "detect quectel_ECxx modem"
		#insmod quectel_GobiNet.ko
		DEV_ATC="/dev/ttyUSB2"
		if [ -n "$quectel_dev_name" ]; then
			NET_IFACE="usb0"
		else
			NET_IFACE="eth1"
		fi
		huayi_cmd set modem modemModel 'EC20'
		uci set network.wan4g.ifname=wwan0
		uci commit
	elif [ -n "$quectel_model_3_support" ]; then
		echo "detect quectel_ECxx modem"
		#insmod quectel_GobiNet.ko
		DEV_ATC="/dev/ttyUSB1"
		NET_IFACE="eth1"
		huayi_cmd set modem modemModel 'EC200T'
	elif [ -n "$neoway_model_1_support" ]; then                        
                echo "detect neoway_N720V5 modem"                            
                                                  
                DEV_ATC="/dev/ttyACM1"                                      
                NET_IFACE="eth1"                                                                      
                huayi_cmd set modem modemModel 'N720V5_V1'  
	elif [ -n "$quectel_model_4_support" ]; then
		echo "detect quectel_ECxx modem"
		#insmod quectel_GobiNet.ko
		DEV_ATC="/dev/ttyUSB1"
		NET_IFACE="eth1"
		huayi_cmd set modem modemModel 'EC200A'
	elif [ -n "$lynq_model_1_support" ]; then
		DEV_ATC="/dev/ttyUSB1"
		NET_IFACE="eth1"
		huayi_cmd set modem modemModel 'LYNQ509'
	else
		echo "no detect modem"
		huayi_cmd set modem registStatus noModem
		echo "NULL" > /tmp/lte_model
		echo "No 4G module!"
		return
	fi

	if [ "$wan_type" == "prior" ]; then
		huayi_cmd set blend cpe_link 1
		huayi_cmd set network wan_link 1
	fi
	if [ "$wan_type" == "rep4g" ]; then
		huayi_cmd set blend cpe_link 1
		huayi_cmd set network wan_link 1
	fi
	huayi_atcmd_server $DEV_ATC &
	
	/etc/init.d/huayi_dial4g restart
}

stop_service() {
 	killall quectel-CM
 	killall -9 quectel-CM
	
	/etc/init.d/huayi_dial4g stop
	killall huayi_atcmd_server
	killall -9 huayi_atcmd_server
	
	if [ -n "$quectel_model_1_support""$quectel_model_2_support""$quectel_model_3_support" ]; then
		killall quectel-CM
		echo "remove modem quectel modem"
		#rmmod quectel_GobiNet.ko
	else
		echo "No 4G module!"
	fi
	
	#rmmod cdc_subset.ko
	#rmmod usbnet.ko
}


