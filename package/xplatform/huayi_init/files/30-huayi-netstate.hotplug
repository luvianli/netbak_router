#!/bin/sh

[ "$INTERFACE" = "loopback" -o "$INTERFACE" = "wan6" -o "$INTERFACE" = "wan_6" ] && return

#echo 30-huayi-netstate,$ACTION,$INTERFACE,$DEVICE > /dev/console

case $INTERFACE in
	wan4g | \
	wan)
		section="wan"
		;;
	lan)
		section="lan"
		;;
	*)
		exit 1
		;;
esac

[ ifup = "$ACTION" ] && {
	local proto=`uci get -c /etc/config network.$section.proto`
	huayi_cmd set network "$section"_device $DEVICE
	[ $proto == "static" ] && {
		local ipaddr=`uci get -c /etc/config network.$INTERFACE.ipaddr`
		local netmask=`uci get -c /etc/config network.$INTERFACE.netmask`
		local gateway=`uci get -c /etc/config network.$INTERFACE.gateway`
		local dns1=`uci get -c /etc/config network.$INTERFACE.dns | awk '{print $1}'`
		local dns2=`uci get -c /etc/config network.$INTERFACE.dns | awk '{print $2}'`
		
		[ -n "$ipaddr" ] &&{
			huayi_cmd set network "$section"_ipv4 $ipaddr
		}
		
		[ -n "$netmask" ] &&{
			huayi_cmd set network subnet_mask p $netmask
			huayi_cmd set network "$section"_netmask $netmask
		}
		
		[ -n "$gateway" ] &&{
			huayi_cmd set network "$section"_gateway $gateway
		}
		
		huayi_cmd set network "$section"_dns_server "0.0.0.0"
		[ -n "$dns1" ] &&{
			huayi_cmd set network "$section"_dns_server $dns1
		}
		
		[ -n "$dns2" ] &&{
			huayi_cmd set network "$section"_dns_server $dns2
		}
	}
	
	[ wan = "$section" ] && {
#		huayi_cmd set network wan_link 1
		huayi_cmd set network wan_up 1
		huayi-reset wanup
		huayi-reset ddns
	}
	huayi-reset static_route
       
}

[ ifdown = "$ACTION" ] && {

#	huayi_cmd set network "$section"_ipv4  "0.0.0.0"
	
#	huayi_cmd set network "$section"_netmask "0.0.0.0"
	
	[ wan = "$section" ] && {
		huayi_cmd set network wan_up 0
	
#		huayi_cmd set network "$section"_gateway "0.0.0.0"
	
#		huayi_cmd set network "$section"_dns_server "0.0.0.0"
	
#		huayi_cmd set network "$section"_device ""
	}	
	
}

