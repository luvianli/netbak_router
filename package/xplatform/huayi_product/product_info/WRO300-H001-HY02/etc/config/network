
config interface 'loopback'
	option ifname 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'lan'
	option force_link '1'
	option type 'bridge'
	option proto 'static'
	option hostname 'ROUTE'
	option ipaddr '192.168.1.1'
	option def_ip '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'
	option ifname 'eth0.1 ra0'
	
config interface 'wan'
	option force_link '1'
	option proto 'dhcp'
	option ifname 'eth0.2'
	option mtu '1500'
	option cc_mtu '1500'
	option ppp_mtu '1492'
