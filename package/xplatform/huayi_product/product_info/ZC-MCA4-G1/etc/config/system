	option enable_server 0

config global 'global'
	option huayi_cmd_debug '0'
	option first_boot	'1'
	option language 'cn'
	list support_language 'cn'
	list support_language 'en'

config login login
	option http_user admin
	option http_pass '21232f297a57a5a743894a0e4a801fc3'

config syslog syslog
	option enabled '0'
	
config sche_reboot sche_reboot
	option sche_reboot_mode		'0'		#0 off  1:rec time 2:special time
	option rectime 	'1800'
	option weeks	'0'
	option hour		'0'		#0 - 23
	option minute	'0'
	
config wifi_sche wifi_sche
	option enabled '0'
	option weeks   '0'
	option start_hour '0'
	option start_minute '0'
	option end_hour '0'
	option end_minute '0'

