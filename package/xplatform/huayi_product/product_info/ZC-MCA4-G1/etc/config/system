config mode	mode
	option opmode '3'  # 0 router mode 1 APmode 2 repeater mode 3 wisp mode
	option wan_type 'rep4g'
	option simchange '0'
	option detect_ip '8.8.8.8'
	option detect_time 300

config system system
	option hostname	ROUTE
	option timezone	CST-8
	option log_size '64'

config timeserver ntp
	list server	cn.ntp.org.cn
