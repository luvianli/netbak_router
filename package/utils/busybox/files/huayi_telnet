START=50

USE_PROCD=1
PROG=/usr/sbin/telnetd


start_service() {
		enable=`/sbin/uci -q get huayi_telnet.telnet.disenable`
		if [ "$enable" -ne 0 ];then
			return
		fi
		procd_open_instance
		procd_set_param command "$PROG" -F -l /bin/login.sh
		procd_close_instance
}

stop_service(){
	service_stop "$PROG"
}
