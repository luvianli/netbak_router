choice
    prompt "MT7620 build type"
    depends on PACKAGE_kmod-mt7620 || PACKAGE_kmod-mt7620
    default MT7620_BUILD_KO
config  MT7620_BUILD_KO
    bool "build as module (MT7620.ko)"
    select PACKAGE_kmod-mt7620-ko
config  MT7620_BUILD_IN
    bool "build into kernel"
    select PACKAGE_kmod-mt7620-in
endchoice


# entries start with "KCONFIG" will be applied to kernel.
config  KCONFIG_WIFI_MT7620
    bool
    default y

# ---------------- 1st card ----------------
config  KCONFIG_FIRST_IF_MT7620
    bool
    select KCONFIG_WIFI_MT7620
    default y
config  KCONFIG_RT_FIRST_CARD
    string
    depends on KCONFIG_FIRST_IF_MT7620
    default "7620"
config  KCONFIG_RT_FIRST_IF_RF_OFFSET
    hex
    depends on KCONFIG_FIRST_IF_MT7620
    default 0x0
