+INT ApCliReportConnStatus(PRTMP_ADAPTER pAd, int CtrlCurrState,int status)
+{
+
+ 	INT i=0;
+ 	UCHAR ifIndex;
+	BOOLEAN bConnect=FALSE;
+
+ 	DBGPRINT(RT_DEBUG_ERROR, ("==>RTMPIoctlConnStatus\n"));
+	
+ 	ifIndex = 0;
+
+ 	DBGPRINT(RT_DEBUG_ERROR, ("=============================================================\n"));
+	
+ 	if((CtrlCurrState == TRUE)
+ 		&& (pAd->ApCfg.ApCliTab[ifIndex].SsidLen != 0))
+ 	{
+ 		for (i=0; i<MAX_LEN_OF_MAC_TABLE; i++)
+ 		{
+ 			PMAC_TABLE_ENTRY pEntry = &pAd->MacTab.Content[i];
+			
+ 			if ( IS_ENTRY_APCLI(pEntry)
+				&& (pEntry->Sst == SST_ASSOC)
+				&& (pEntry->PortSecured == WPA_802_1X_PORT_SECURED)
+				&& (status == 1))
+ 				{
+					DBGPRINT(RT_DEBUG_ERROR, ("ApCli%d Connected AP : %02X:%02X:%02X:%02X:%02X:%02X   SSID:%s\n",
+							ifIndex, PRINT_MAC(pEntry->Addr), pAd->ApCfg.ApCliTab[ifIndex].Ssid));
+					bConnect=TRUE;
+					ApCliSendNetLinkMsg(status);
+ 				}
+ 		}
+
+		if (!bConnect && (status == 0))
+		{
+			DBGPRINT(RT_DEBUG_ERROR, ("ApCli%d Connected AP : Disconnect\n",ifIndex));
+			ApCliSendNetLinkMsg(status);
+		}
+ 	}
+ 	else if(status == 0)
+ 	{
+		DBGPRINT(RT_DEBUG_ERROR, ("ApCli%d Connected AP : Disconnect\n",ifIndex));
+		ApCliSendNetLinkMsg(status);
+ 	}
+
+ 	DBGPRINT(RT_DEBUG_ERROR, ("=============================================================\n"));
+    DBGPRINT(RT_DEBUG_ERROR, ("<==RTMPIoctlConnStatus\n"));
+
+ 	return TRUE;
+}
+#endif
