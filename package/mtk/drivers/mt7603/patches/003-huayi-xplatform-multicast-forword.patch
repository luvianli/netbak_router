+INT Set_IgmpSn_Forword_Proc(RTMP_ADAPTER *pAd, RTMP_STRING *arg)
+{
+	UINT Enable;
+
+	Enable = (UINT) simple_strtol(arg, 0, 10);
+
+	pAd->ApCfg.IgmpForword = Enable;
+	DBGPRINT(RT_DEBUG_TRACE, ("%s:: %s\n", __FUNCTION__, Enable == 1 ? "Enable IGMP Forword":"Disable IGMP Forword"));
+
+	return TRUE;
+}
+
 INT Set_IgmpSn_AddEntry_Proc(RTMP_ADAPTER *pAd, RTMP_STRING *arg)
 {
 	INT i;
@@ -993,6 +1005,26 @@
 	}
 }
 
+void rtmp_read_igmp_forword_from_file(
+	IN  PRTMP_ADAPTER pAd,
+	RTMP_STRING *tmpbuf,
+	RTMP_STRING *buffer)
+{
+	/*IgmpForword */
+	if(RTMPGetKeyParameter("IgmpForword", tmpbuf, 128, buffer, TRUE))
+	{
+		if ((strncmp(tmpbuf, "0", 1) == 0))
+			pAd->ApCfg.IgmpForword = 0;
+		else if ((strncmp(tmpbuf, "1", 1) == 0))
+			pAd->ApCfg.IgmpForword = 1;
+        else
+			pAd->ApCfg.IgmpForword = 0;
+
+		DBGPRINT(RT_DEBUG_TRACE, (" IGMP Snooping Enable=%d\n", pAd->ApCfg.IgmpForword));
+	}
+}
