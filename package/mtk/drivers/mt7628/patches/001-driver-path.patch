Index: linux-3.10.108/drivers/net/wireless/mtk/mt7628/mt7628_wifi_ap/Makefile
===================================================================
--- linux-3.10.108.orig/drivers/net/wireless/mtk/mt7628/mt7628_wifi_ap/Makefile	2019-04-26 14:33:23.000000000 +0800
+++ linux-3.10.108/drivers/net/wireless/mtk/mt7628/mt7628_wifi_ap/Makefile	2019-04-26 14:51:34.433906095 +0800
@@ -1,17 +1,17 @@
 
 ifeq ($(CONFIG_SUPPORT_OPENWRT),y)
-EXTRA_CFLAGS = -I$(src)/../src/include \
-				-I$(src)/../src/embedded/include \
-				-I$(src)/../src/ate/include
+EXTRA_CFLAGS = -I$(src)/../mt7628_wifi/include \
+				-I$(src)/../mt7628_wifi/embedded/include \
+				-I$(src)/../mt7628_wifi/ate/include
 DRV_NAME = mt7628
-SRC_DIR = ../src/embedded
-obj-m += $(DRV_NAME).o
+SRC_DIR = ../mt7628_wifi/embedded
+obj-$(CONFIG_MT7628_AP_SUPPORT) += $(DRV_NAME).o
 else
-EXTRA_CFLAGS = -Idrivers/net/wireless/mt_wifi/include \
-				-Idrivers/net/wireless/mt_wifi/embedded/include \
-				-Idrivers/net/wireless/mt_wifi/ate/include
-DRV_NAME = mt_wifi
-SRC_DIR = ../mt_wifi/embedded
+EXTRA_CFLAGS = -Idrivers/net/wireless/mtk/mt7628/mt7628_wifi/include \
+				-Idrivers/net/wireless/mtk/mt7628/mt7628_wifi/embedded/include \
+				-Idrivers/net/wireless/mtk/mt7628/mt7628_wifi/ate/include
+DRV_NAME = mt7628_wifi
+SRC_DIR = ../mt7628_wifi/embedded
 obj-$(CONFIG_MT7628_AP_SUPPORT) += $(DRV_NAME).o
 endif
 
@@ -112,7 +112,7 @@
 #	spec_objs += $(SRC_DIR)/common/ral_ps.o
 #endif
 
-ifeq ($(CONFIG_MT_MAC),y)
+ifeq ($(CONFIG_MT7628_MAC),y)
 	EXTRA_CFLAGS += -DMT_PS
 	spec_objs += $(SRC_DIR)/common/mt_ps.o
 	spec_objs += $(SRC_DIR)/common/mt_io.o
