 VOID MlmeHandler(RTMP_ADAPTER *pAd) 
 {
+	UINT32 process_cnt = 0;
 	MLME_QUEUE_ELEM *Elem = NULL;
 #ifdef APCLI_SUPPORT
 	SHORT apcliIfIndex;
@@ -767,6 +768,13 @@
 		}	
 #endif /* CONFIG_ATE */
 
+		/* For worst case, avoid process mlme.queue too long which cause RCU_sched stall */
