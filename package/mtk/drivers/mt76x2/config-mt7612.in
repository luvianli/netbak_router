choice
    prompt "mt7612 build type"
    depends on PACKAGE_kmod-mt76x2
    default MT7612E_BUILD_KO
config  MT7612E_BUILD_KO
    bool "build as module (mt7612.ko)"
    select PACKAGE_kmod-mt7612-ko
config  MT7612E_BUILD_IN
    bool "build into kernel"
    select PACKAGE_kmod-mt7612-in
endchoice


# entries start with "KCONFIG" will be applied to kernel.
config  KCONFIG_WIFI_MT7612E
    bool
    default n

# ---------------- 1st card ----------------
config  KCONFIG_FIRST_IF_MT7612E
    bool "mt7612 as 1st card"
    select KCONFIG_WIFI_MT7612E
    default n
config  KCONFIG_RT_FIRST_CARD
    string
    depends on KCONFIG_FIRST_IF_MT7612E
    default "7612e"
config  KCONFIG_RT_FIRST_IF_RF_OFFSET
    hex
    depends on KCONFIG_FIRST_IF_MT7612E
    default 0x0

# ---------------- 2nd card ----------------
config  KCONFIG_SECOND_IF_MT7612E
    bool "mt7612 as 2nd card"
    select KCONFIG_WIFI_MT7612E
    default n
config  KCONFIG_RT_SECOND_CARD
    string
    depends on KCONFIG_SECOND_IF_MT7612E
    default "7612e"
config  KCONFIG_RT_SECOND_IF_RF_OFFSET
    hex
    depends on KCONFIG_SECOND_IF_MT7612E
    default 0x8000
