choice
    prompt "MT7602 build type"
    depends on PACKAGE_kmod-mt7602 || PACKAGE_kmod-mt7602
    default MT7602_BUILD_KO
config  MT7602_BUILD_KO
    bool "build as module (MT76x2.ko)"
    select PACKAGE_kmod-mt76x2-ko
config  MT7602_BUILD_IN
    bool "build into kernel"
    select PACKAGE_kmod-mt76x2-in
endchoice


# entries start with "KCONFIG" will be applied to kernel.
config  KCONFIG_WIFI_MT7602
    bool
    default y

# ---------------- 1st card ----------------
config  KCONFIG_FIRST_IF_MT76X2
    bool "mt7602 as 1st card"
    select KCONFIG_WIFI_MT76X2
    default y
config  KCONFIG_RT_FIRST_CARD
    string
    depends on KCONFIG_FIRST_IF_MT76X2
    default "7602"
config  KCONFIG_RT_FIRST_IF_RF_OFFSET
    hex
    depends on KCONFIG_FIRST_IF_MT76X2
    default 0x0

# ---------------- 2st card ----------------
config  KCONFIG_SECOND_IF_MT76X2
    bool "mt7602 as 2st card"
    select KCONFIG_WIFI_MT76X2
    default y
config  KCONFIG_RT_SECOND_CARD
    string
    depends on KCONFIG_SECOND_IF_MT76X2
    default "7602"
config  KCONFIG_RT_SECOND_IF_RF_OFFSET
    hex
    depends on KCONFIG_SECOND_IF_MT76X2
    default 0x8000