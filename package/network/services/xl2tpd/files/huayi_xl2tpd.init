#!/bin/sh /etc/rc.common
# Copyright (C) 2006-2015 OpenWrt.org

START=60
USE_PROCD=1

BIN=/usr/sbin/xl2tpd
RUN_D="/var/run/xl2tpd"
PID_F="/var/run/xl2tpd.pid"
XL2TPD_PREOPTIONS=/etc/ppp/options.xl2tpd
OPTIONS=/var/etc/options.xl2tpd
XL2TPD_PRECONFIG=/etc/xl2tpd/xl2tpd.conf
CONFIG=/var/etc/xl2tpd.conf


validate_xl2tpd_section() {
	uci_validate_section xl2tpd service xl2tpd \
		'enable:uinteger' \
		'server_ip:string' \
		'startip:string' \
		'endip:string' \
		'mtu:uinteger' \
		'mru:uinteger' \
		'dns_enable:uinteger' \
		'primary_dns:string' \
		'secondary_dns:string' \
		'ipsec_enable:uinteger' \
		'ipsec_key:string'
}

setup_config() {
	validate_xl2tpd_section || {
		echo "validation failed"
		return 1
	}

	[ "$enable" -eq 0 ] && return 1
	
	mkdir -p /var/etc   						
	cp $XL2TPD_PREOPTIONS $OPTIONS  						
	cp $XL2TPD_PRECONFIG $CONFIG
	
	echo "ip range = ${startip}-${endip}" >> $CONFIG
	echo "local ip = ${server_ip}" >> $CONFIG
	
	echo " " >> $OPTIONS
	[ -n "$mtu" ] && echo "mtu $mtu" >> $OPTIONS
	[ -n "$mru" ] && echo "mru $mru" >> $OPTIONS	
	[ "$dns_enable" -eq 1 ] && echo "ms-dns $primary_dns" >> $OPTIONS  
	[ "$dns_enable" -eq 1 ] && echo "ms-dns $secondary_dns" >> $OPTIONS
	return 0
}

start_service() {
	rm -rf "$RUN_D"
	mkdir -p "$RUN_D"

	config_load xl2tpd
	setup_config || return

	procd_open_instance
	procd_set_param command $BIN -D -l -p "$PID_F" -c $CONFIG
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	service_stop $BIN
	rm -rf "$RUN_D"
	rm -rf "$PID_F"
	rm -rf $CONFIG
}
