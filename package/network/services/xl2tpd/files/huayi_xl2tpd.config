config service 'xl2tpd'
       option 'enable' 0
       option 'server_ip' '192.168.7.1'
       option 'startip' '172.1.1.30'
       option 'endip'   '172.1.1.40'
       option 'mtu' 1400
       option 'mru' 1400
       option 'dns_enable' 0
       option 'primary_dns' ''
       option 'secondary_dns' ''
       option 'ipsec_enable' 0
       option 'ipsec_key' ''
